<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dairy_breeding_event" model="ir.sequence">
            <field name="name">Breeding Event</field>
            <field name="code">dairy.breeding.event</field>
            <field name="prefix">BRD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_pregnancy_check" model="ir.sequence">
            <field name="name">Pregnancy Check</field>
            <field name="code">dairy.pregnancy.check</field>
            <field name="prefix">PREG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_calving_event" model="ir.sequence">
            <field name="name">Calving</field>
            <field name="code">dairy.calving.event</field>
            <field name="prefix">CLV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
