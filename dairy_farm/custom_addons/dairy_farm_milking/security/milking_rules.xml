<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_milking_session_company" model="ir.rule">
            <field name="name">Milking session: multi-company</field>
            <field name="model_id" ref="model_dairy_milking_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_milking_line_company" model="ir.rule">
            <field name="name">Milking line: multi-company</field>
            <field name="model_id" ref="model_dairy_milking_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_milking_correction_company" model="ir.rule">
            <field name="name">Milking correction: multi-company</field>
            <field name="model_id" ref="model_dairy_milking_correction"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Operators edit only draft sessions; managers (supervisors) edit all states. -->
        <record id="rule_milking_session_operator_draft" model="ir.rule">
            <field name="name">Milking session: operators modify drafts only</field>
            <field name="model_id" ref="model_dairy_milking_session"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_milking_operator'))]"/>
            <field name="domain_force">[('state', '=', 'draft')]</field>
            <field name="perm_read" eval="False"/>
        </record>
        <record id="rule_milking_session_manager_all" model="ir.rule">
            <field name="name">Milking session: managers modify all</field>
            <field name="model_id" ref="model_dairy_milking_session"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
        </record>
        <record id="rule_milking_line_operator_draft" model="ir.rule">
            <field name="name">Milking line: operators modify drafts only</field>
            <field name="model_id" ref="model_dairy_milking_line"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_milking_operator'))]"/>
            <field name="domain_force">[('session_id.state', '=', 'draft')]</field>
            <field name="perm_read" eval="False"/>
        </record>
        <record id="rule_milking_line_manager_all" model="ir.rule">
            <field name="name">Milking line: managers modify all</field>
            <field name="model_id" ref="model_dairy_milking_line"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
        </record>
        <record id="rule_milking_correction_operator_own" model="ir.rule">
            <field name="name">Milking correction: operators modify own requests</field>
            <field name="model_id" ref="model_dairy_milking_correction"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_milking_operator'))]"/>
            <field name="domain_force">[('requested_by_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="perm_read" eval="False"/>
        </record>
        <record id="rule_milking_correction_manager_all" model="ir.rule">
            <field name="name">Milking correction: managers modify all</field>
            <field name="model_id" ref="model_dairy_milking_correction"/>
            <field name="groups" eval="[(4, ref('dairy_farm_core.group_dairy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
        </record>
    </data>
</odoo>
