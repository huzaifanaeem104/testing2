<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dairy_milking_session" model="ir.sequence">
            <field name="name">Milking Session</field>
            <field name="code">dairy.milking.session</field>
            <field name="prefix">MLK/%(y)s%(month)s%(day)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_milking_correction" model="ir.sequence">
            <field name="name">Milking Correction</field>
            <field name="code">dairy.milking.correction</field>
            <field name="prefix">MCOR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
