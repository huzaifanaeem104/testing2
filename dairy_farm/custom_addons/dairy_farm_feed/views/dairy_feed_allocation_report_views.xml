<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dairy_feed_allocation_report_search" model="ir.ui.view">
        <field name="name">dairy.feed.allocation.report.search</field>
        <field name="model">dairy.feed.allocation.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <field name="group_id"/>
                <field name="product_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <filter name="filter_last_30" string="Last 30 Days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group string="Group By">
                    <filter name="groupby_animal" string="Animal" context="{'group_by': 'animal_id'}"/>
                    <filter name="groupby_group" string="Group" context="{'group_by': 'group_id'}"/>
                    <filter name="groupby_product" string="Feed" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dairy_feed_allocation_report_pivot" model="ir.ui.view">
        <field name="name">dairy.feed.allocation.report.pivot</field>
        <field name="model">dairy.feed.allocation.report</field>
        <field name="arch" type="xml">
            <pivot string="Feed Cost per Animal">
                <field name="animal_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="cost" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dairy_feed_allocation_report_list" model="ir.ui.view">
        <field name="name">dairy.feed.allocation.report.list</field>
        <field name="model">dairy.feed.allocation.report</field>
        <field name="arch" type="xml">
            <list string="Feed Cost per Animal">
                <field name="date"/>
                <field name="animal_id"/>
                <field name="group_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="consumption_id"/>
            </list>
        </field>
    </record>

    <record id="action_dairy_feed_allocation_report" model="ir.actions.act_window">
        <field name="name">Feed Cost per Cow</field>
        <field name="res_model">dairy.feed.allocation.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_filter_last_30': 1}</field>
    </record>
</odoo>
