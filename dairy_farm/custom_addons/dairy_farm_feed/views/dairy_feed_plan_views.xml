<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dairy_feed_plan_search" model="ir.ui.view">
        <field name="name">dairy.feed.plan.search</field>
        <field name="model">dairy.feed.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="group_id"/>
                <field name="animal_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group string="Group By">
                    <filter name="groupby_group" string="Group" context="{'group_by': 'group_id'}"/>
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dairy_feed_plan_list" model="ir.ui.view">
        <field name="name">dairy.feed.plan.list</field>
        <field name="model">dairy.feed.plan</field>
        <field name="arch" type="xml">
            <list string="Feeding Plans" decoration-muted="state == 'closed'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="description"/>
                <field name="target_type"/>
                <field name="group_id"/>
                <field name="animal_id" optional="hide"/>
                <field name="head_count"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_dairy_feed_plan_form" model="ir.ui.view">
        <field name="name">dairy.feed.plan.form</field>
        <field name="model">dairy.feed.plan</field>
        <field name="arch" type="xml">
            <form string="Feeding Plan">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'" groups="dairy_farm_core.group_dairy_manager"/>
                    <button name="action_generate_consumption" type="object" string="Generate Feeding Records"
                            class="btn-primary" invisible="state != 'active'"
                            groups="dairy_farm_core.group_dairy_feed_operator"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'active'" groups="dairy_farm_core.group_dairy_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'" groups="dairy_farm_core.group_dairy_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_consumption" type="object" class="oe_stat_button" icon="fa-cutlery">
                            <field name="consumption_count" widget="statinfo" string="Feeding Records"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="description" placeholder="e.g. Lactating ration - summer"/>
                    </div>
                    <group>
                        <group>
                            <field name="target_type" readonly="state != 'draft'" widget="radio" options="{'horizontal': true}"/>
                            <field name="group_id" invisible="target_type != 'group'" required="target_type == 'group'"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="animal_id" invisible="target_type != 'animal'" required="target_type == 'animal'"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="head_count"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state == 'closed'"/>
                            <field name="date_to" readonly="state == 'closed'"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ration" name="ration">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="shift_id" options="{'no_create': True}"/>
                                    <field name="qty_per_head"/>
                                    <field name="uom_category_id" column_invisible="1"/>
                                    <field name="uom_id" domain="[('category_id', '=', uom_category_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="planned_qty"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dairy_feed_plan" model="ir.actions.act_window">
        <field name="name">Feeding Plans</field>
        <field name="res_model">dairy.feed.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="view_dairy_feed_generate_wizard_form" model="ir.ui.view">
        <field name="name">dairy.feed.generate.wizard.form</field>
        <field name="model">dairy.feed.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Feeding Records">
                <group>
                    <field name="date"/>
                    <field name="plan_ids" widget="many2many_tags"/>
                </group>
                <p class="text-muted">Creates draft feeding records with the planned quantities. Records that
                   already exist for the same plan line, date and shift are not duplicated. Adjust the actual
                   quantities, then post them to Inventory.</p>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dairy_feed_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Feeding Records</field>
        <field name="res_model">dairy.feed.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
