<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dairy_animal_form_feed" model="ir.ui.view">
        <field name="name">dairy.animal.form.feed</field>
        <field name="model">dairy.animal</field>
        <field name="inherit_id" ref="dairy_farm_core.view_dairy_animal_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_feed_allocation" type="object" class="oe_stat_button" icon="fa-leaf">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="feed_cost_30d" widget="monetary"/></span>
                        <span class="o_stat_text">Feed 30 Days</span>
                    </div>
                </button>
            </div>
            <page name="feeding" position="inside">
                <field name="feed_consumption_ids">
                    <list>
                        <field name="date"/>
                        <field name="name"/>
                        <field name="group_id"/>
                        <field name="product_id"/>
                        <field name="actual_qty"/>
                        <field name="uom_id"/>
                        <field name="head_count"/>
                        <field name="cost_per_head"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="state"/>
                    </list>
                </field>
            </page>
        </field>
    </record>
</odoo>
