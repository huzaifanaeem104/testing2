<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dairy_feed_plan" model="ir.sequence">
            <field name="name">Feeding Plan</field>
            <field name="code">dairy.feed.plan</field>
            <field name="prefix">FPLAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_feed_consumption" model="ir.sequence">
            <field name="name">Feed Consumption</field>
            <field name="code">dairy.feed.consumption</field>
            <field name="prefix">FEED/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
