<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_vaccination_reminders" model="ir.cron">
            <field name="name">Dairy: vaccination reminders</field>
            <field name="model_id" ref="model_dairy_vaccination"/>
            <field name="state">code</field>
            <field name="code">model._cron_vaccination_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_followup_reminders" model="ir.cron">
            <field name="name">Dairy: overdue veterinary follow-ups</field>
            <field name="model_id" ref="model_dairy_health_followup"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_medicine_stock_alerts" model="ir.cron">
            <field name="name">Dairy: low medicine stock alerts</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_medicine_stock_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
