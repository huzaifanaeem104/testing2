<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dairy_health_case" model="ir.sequence">
            <field name="name">Health Case</field>
            <field name="code">dairy.health.case</field>
            <field name="prefix">HC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_treatment" model="ir.sequence">
            <field name="name">Treatment</field>
            <field name="code">dairy.treatment</field>
            <field name="prefix">TRT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dairy_vaccination" model="ir.sequence">
            <field name="name">Vaccination</field>
            <field name="code">dairy.vaccination</field>
            <field name="prefix">VAC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
