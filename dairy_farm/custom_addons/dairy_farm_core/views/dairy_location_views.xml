<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dairy_location_list" model="ir.ui.view">
        <field name="name">dairy.location.list</field>
        <field name="model">dairy.location</field>
        <field name="arch" type="xml">
            <list string="Farm Locations">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="location_type"/>
                <field name="capacity"/>
                <field name="animal_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dairy_location_form" model="ir.ui.view">
        <field name="name">dairy.location.form</field>
        <field name="model">dairy.location</field>
        <field name="arch" type="xml">
            <form string="Farm Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_animals" type="object" class="oe_stat_button" icon="fa-paw">
                            <field name="animal_count" widget="statinfo" string="Animals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Barn A"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location_type"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dairy_location_search" model="ir.ui.view">
        <field name="name">dairy.location.search</field>
        <field name="model">dairy.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group string="Group By">
                    <filter name="groupby_type" string="Type" context="{'group_by': 'location_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dairy_location" model="ir.actions.act_window">
        <field name="name">Farm Locations</field>
        <field name="res_model">dairy.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
