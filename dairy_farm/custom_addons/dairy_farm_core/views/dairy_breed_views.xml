<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dairy_breed_list" model="ir.ui.view">
        <field name="name">dairy.breed.list</field>
        <field name="model">dairy.breed</field>
        <field name="arch" type="xml">
            <list string="Breeds">
                <field name="name"/>
                <field name="code"/>
                <field name="origin"/>
                <field name="expected_daily_yield"/>
                <field name="animal_count"/>
            </list>
        </field>
    </record>

    <record id="view_dairy_breed_form" model="ir.ui.view">
        <field name="name">dairy.breed.form</field>
        <field name="model">dairy.breed</field>
        <field name="arch" type="xml">
            <form string="Breed">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_animals" type="object" class="oe_stat_button" icon="fa-paw">
                            <field name="animal_count" widget="statinfo" string="Animals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Sahiwal"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="expected_daily_yield"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dairy_breed" model="ir.actions.act_window">
        <field name="name">Breeds</field>
        <field name="res_model">dairy.breed</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
