<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_ages_running_bill" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ages.running.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Keep these on the right so they do not stack under Client -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="ages_running_bill_id" readonly="1"
                         invisible="move_type not in ('out_invoice', 'out_refund') or not ages_running_bill_id"/>
            </xpath>
        </field>
    </record>

</odoo>
