<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_running_bill_list" model="ir.ui.view">
        <field name="name">ages.running.bill.list.full</field>
        <field name="model">ages.running.bill</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Running Bills">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="contract_id"/>
                <field name="project_wise_contract" optional="show"/>
                <field name="contract_description" optional="show"/>
                <field name="value_of_work_done"/>
                <field name="ex_rebate_mr_value"/>
                <field name="total_receivable"/>
                <field name="mobilization_amount"/>
                <field name="retention_amount"/>
                <field name="net_amount"/>
                <field name="invoice_payment_state" string="Payment Status" widget="badge"
                         decoration-warning="invoice_payment_state in ('not_paid', 'partial')"
                         decoration-info="invoice_payment_state == 'in_payment'"
                         decoration-success="invoice_payment_state == 'paid'"
                         decoration-danger="invoice_payment_state in ('reversed', 'blocked')"/>
                <field name="state" widget="badge"
                         decoration-info="state == 'draft'"
                         decoration-success="state == 'confirmed'"
                         decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ages_running_bill_kanban" model="ir.ui.view">
        <field name="name">ages.running.bill.kanban</field>
        <field name="model">ages.running.bill</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="net_amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column gap-1">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="partner_id"/>
                            <div class="text-muted">
                                <field name="date"/>
                            </div>
                            <div>
                                <span class="text-muted">Net: </span>
                                <field name="net_amount"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ages_running_bill_form" model="ir.ui.view">
        <field name="name">ages.running.bill.form.full</field>
        <field name="model">ages.running.bill</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Running Bill">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="contract_count == 0">
                            <field name="contract_count" widget="statinfo" string="Contract"/>
                        </button>
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                                <span class="o_stat_text">
                                    <field name="invoice_payment_state"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="Running Bill Details" col="4">
                        <field name="partner_id" readonly="state != 'draft'"/>
                        <field name="date" readonly="state != 'draft'"/>
                        <field name="contract_id" readonly="state != 'draft'"/>
                        <field name="project_wise_contract" readonly="1"/>
                        <field name="contract_description" readonly="1" class="fw-bold"/>
                        <field name="project_id" readonly="state != 'draft'"/>
                        <field name="analytic_account_id" readonly="1"/>
                        <field name="sub_company_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="invoice_id" invisible="1"/>
                        <field name="invoice_payment_state" string="Payment Status" widget="badge"
                                 decoration-warning="invoice_payment_state in ('not_paid', 'partial')"
                                 decoration-info="invoice_payment_state == 'in_payment'"
                                 decoration-success="invoice_payment_state == 'paid'"
                                 decoration-danger="invoice_payment_state in ('reversed', 'blocked')"
                                 invisible="not invoice_id"/>
                    </group>

                    <group string="Amounts" name="amounts" col="3">
                        <group string="1. Work Progress" name="amounts_work_progress">
                            <label for="value_of_work_done"/>
                            <div class="o_row">
                                <field name="value_of_work_done" readonly="state != 'draft'"
                                         class="oe_inline" nolabel="1"/>
                                <span class="mx-1">/</span>
                                <field name="contract_total_work_done" readonly="1"
                                         class="oe_inline" nolabel="1"/>
                            </div>
                            <field name="value_of_work_done_display" invisible="1"/>
                            <field name="rebate_percent" readonly="state != 'draft'"/>
                            <field name="rebate_amount" readonly="state != 'draft'" force_save="1"/>
                            <field name="ex_rebate_value" readonly="1"/>
                            <field name="material_recovery" readonly="1"/>
                            <field name="ex_rebate_mr_value" readonly="1"/>
                        </group>
                        <group string="2. Recovery &amp; Retention" name="amounts_recovery_retention">
                            <field name="mobilization_percent" readonly="state != 'draft'"/>
                            <field name="mobilization_amount" readonly="1"/>
                            <field name="wht_on_mobilization" readonly="state != 'draft'"/>
                            <field name="retention_percent" readonly="state != 'draft'"/>
                            <field name="retention_amount" readonly="1"/>
                            <field name="wht_on_retention" readonly="state != 'draft'"/>
                        </group>
                        <group string="3. Taxes &amp; Withholding" name="amounts_taxes">
                            <field name="allowed_sales_tax_ids" invisible="1"/>
                            <field name="allowed_wth_tax_ids" invisible="1"/>
                            <field name="allowed_wth_on_sales_tax_ids" invisible="1"/>
                            <field name="sales_tax_id" readonly="state != 'draft'"
                                     domain="[('type_tax_use', '=', 'sale'), ('tax_scope', '=', 'service'), ('active', '=', True), ('id', 'in', allowed_sales_tax_ids)]"/>
                            <field name="sales_tax_amount" readonly="1"/>
                            <field name="wth_on_sales_tax_id" readonly="state != 'draft'"
                                     domain="[('type_tax_use', '=', 'sale'), ('tax_scope', '=', 'service'), ('active', '=', True), ('amount', '&lt;', 0), ('id', 'in', allowed_wth_on_sales_tax_ids)]"/>
                            <field name="wth_on_sales_tax_amount" readonly="1"/>
                            <field name="wth_tax_id" readonly="state != 'draft'"
                                     domain="[('is_withholding_tax_on_payment', '=', True), ('active', '=', True), ('id', 'in', allowed_wth_tax_ids)]"/>
                            <field name="wth_amount" readonly="1"/>
                        </group>
                    </group>

                    <group string="Summary" name="amounts_summary" col="3">
                        <group>
                            <field name="total_receivable_ex_sales_tax" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_receivable" readonly="1"/>
                        </group>
                        <group>
                            <field name="net_amount" readonly="1"/>
                            <field name="invoiced_amount" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Recovery Material" name="recovery_material">
                            <field name="material_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="contract_line_id" column_invisible="1"/>
                                    <field name="material"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="contract_quantity" readonly="1" optional="hide"/>
                                    <field name="quantity_display" string="Remaining" readonly="1"/>
                                    <field name="uom_id"/>
                                    <field name="rate" readonly="1" force_save="1"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Amount Bases" name="amount_bases">
                            <group>
                                <field name="mobilization_amount_base" readonly="state != 'draft'"/>
                                <field name="retention_amount_base" readonly="state != 'draft'"/>
                                <field name="sales_tax_amount_base" readonly="state != 'draft'"/>
                            </group>
            <div class="text-muted">
                                Mobilization, Retention and Sales Tax amounts use the selected
                                Amount-Base (A = Value of Work Done, C = Ex Rebate Value,
                                E = Ex Rebate &amp; MR Value). Defaults come from the Contract,
                                then Project Settings → Default Bases.
                                WTH Amount = WTH % × (Ex Rebate &amp; MR + Sales Tax Amount
                                − |WTH on Sales Tax| − Mobilization and/or Retention when those
                                WHT checkboxes are ticked). Sales Tax Amount Base is used only
                                to compute Sales Tax Amount.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ages_running_bill_search" model="ir.ui.view">
        <field name="name">ages.running.bill.search</field>
        <field name="model">ages.running.bill</field>
        <field name="arch" type="xml">
            <search string="Running Bills">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="groupby_customer" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Disable placeholder form from menu module -->
    <record id="ages_contracts_menu.view_ages_running_bill_form" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="ages_contracts_menu.view_ages_running_bill_list" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="ages_contracts_menu.action_ages_running_bill" model="ir.actions.act_window">
        <field name="name">Running Bills</field>
        <field name="res_model">ages.running.bill</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_ages_running_bill_list"/>
        <field name="search_view_id" ref="view_ages_running_bill_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Running Bill
            </p>
            <p>
                Confirm a Running Bill to auto-create and post the customer invoice.
            </p>
        </field>
    </record>

    <record id="action_ages_running_bill_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ages_running_bill_list"/>
        <field name="act_window_id" ref="ages_contracts_menu.action_ages_running_bill"/>
    </record>
    <record id="action_ages_running_bill_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_ages_running_bill_kanban"/>
        <field name="act_window_id" ref="ages_contracts_menu.action_ages_running_bill"/>
    </record>
    <record id="action_ages_running_bill_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ages_running_bill_form"/>
        <field name="act_window_id" ref="ages_contracts_menu.action_ages_running_bill"/>
    </record>

</odoo>
