<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ages_payroll_holidays" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ages.payroll.holidays</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ages_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ages_hr_payroll']" position="inside">
                <block title="Time Off">
                    <setting string="Deferred Time Off"
                             help="Responsible user for time off deferred after payslip validation">
                        <div class="content-group">
                            <div class="row mt16 ms-2">
                                <label for="deferred_time_off_manager"
                                       string="Responsible"
                                       class="col-md-6 p-0 m-0 o_light_label"/>
                                <field name="deferred_time_off_manager" class="col-lg-6 p-0"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
