<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ages_asset_transfer" model="ir.module.category">
        <field name="name">Asset Transfer</field>
        <field name="parent_id" ref="base.module_category_accounting"/>
        <field name="sequence">55</field>
    </record>

    <record id="group_asset_transfer_user" model="res.groups">
        <field name="name">Project Manager / Site Supervisor</field>
        <field name="category_id" ref="module_category_ages_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Can create/edit draft transfers and confirm them.</field>
    </record>

    <record id="group_asset_transfer_manager" model="res.groups">
        <field name="name">Warehouse / Asset Manager</field>
        <field name="category_id" ref="module_category_ages_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_transfer_user'))]"/>
        <field name="comment">Can validate (done) and cancel asset transfers.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_asset_transfer_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_ages_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Read-only access to asset transfers and history.</field>
    </record>

</odoo>
