<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_asset_transfer_company" model="ir.rule">
        <field name="name">Asset Transfer multi-company</field>
        <field name="model_id" ref="model_asset_transfer"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_asset_transfer_line_company" model="ir.rule">
        <field name="name">Asset Transfer Line multi-company</field>
        <field name="model_id" ref="model_asset_transfer_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_asset_transfer_history_company" model="ir.rule">
        <field name="name">Asset Transfer History multi-company</field>
        <field name="model_id" ref="model_asset_transfer_history"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
