<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payroll.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ages_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ages_hr_payroll']" position="inside">
                <block title="Accounting">
                    <setting string="Batch journal items" help="Group payslip lines into shared journal entries">
                        <field name="batch_payroll_move_lines"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
