<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- XLSX Report Action for Branch Transfer Note -->
    <record id="action_purchase_detail_report_xlsx" model="ir.actions.report">
        <field name="name">Purchase Detail Report Wizard</field>

        <!-- Bind to wizard -->
        <field name="model">purchase.detail.report.wizard</field>

        <field name="report_type">xlsx</field>

        <!-- Must match _name of report class -->
        <field name="report_name">purchase_detail.report_xlsx</field>

        <!-- Optional but consistent -->
        <field name="report_file">purchase_detail.report_xlsx</field>

        <!-- Auto filename -->
        <field name="print_report_name">'purchase_detail.xlsx'</field>

        <!-- Bind the report to the wizard -->
        <field name="binding_model_id" ref="model_purchase_detail_report_wizard"/>
    </record>

</odoo>
