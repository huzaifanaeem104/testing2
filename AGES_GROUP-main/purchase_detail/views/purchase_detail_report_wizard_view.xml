<odoo>
    <record id="view_otp_generate_report_wizard" model="ir.ui.view">
        <field name="name">purchase.detail.wizard.form</field>
        <field name="model">purchase.detail.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Detail Report">
                <group>
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="project_ids" widget="many2many_tags"/>
                    <field name="uom_id"/>
                    <field name="supplier_id" widget="many2many_tags"/>
                    <field name="city_location_ids" widget="many2many_tags"/>
                </group>

                <footer>
                    <button name="action_preview"
                            type="object"
                            string="Preview"
                            class="btn-secondary"/>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
