<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_material_request_list" model="ir.ui.view">
        <field name="name">construction.material.request.list</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'issued'" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="required_date"/>
                <field name="vendor_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="construction_management_pro.group_construction_manager"/>
                    <button name="action_create_rfq" type="object" string="Create RFQ" invisible="state not in ('submitted','approved')" groups="construction_management_pro.group_construction_procurement,construction_management_pro.group_construction_manager"/>
                    <button name="action_create_internal_transfer" type="object" string="Issue from Stock" invisible="state not in ('approved','ordered')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('issued','cancel')"/>
                    <button name="action_reset_draft" type="object" string="Reset" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="task_id"/>
                            <field name="requested_by"/>
                            <field name="request_date"/>
                            <field name="required_date"/>
                        </group>
                        <group>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="vendor_id"/>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="estimated_unit_cost"/>
                            <field name="boq_line_id" optional="hide" domain="[('project_id','=',parent.project_id)]"/>
                        </list>
                    </field>
                    <group string="Notes"><field name="notes" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">construction.material.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
