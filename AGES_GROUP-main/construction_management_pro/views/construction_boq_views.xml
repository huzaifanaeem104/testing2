<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_boq_list" model="ir.ui.view">
        <field name="name">construction.boq.list</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="revision"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="material_amount"/>
                <field name="manufactured_amount"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="construction_management_pro.group_construction_manager"/>
                    <button name="action_create_tasks" type="object" string="Create Tasks" invisible="state != 'approved'"/>
                    <button name="action_create_manufacturing_orders" type="object" string="Create Manufacturing Orders" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved','cancel')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('cancel','submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state == 'approved'"/>
                            <field name="partner_id"/>
                            <field name="revision"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Lines">
                            <field name="line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="line_type"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="bom_id" optional="hide"/>
                                    <field name="task_id" optional="hide"/>
                                    <field name="production_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="material_amount"/>
                                <field name="labor_amount"/>
                                <field name="equipment_amount"/>
                                <field name="subcontract_amount"/>
                                <field name="manufactured_amount"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_boq" model="ir.actions.act_window">
        <field name="name">Bills of Quantities</field>
        <field name="res_model">construction.boq</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
