<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_subcontract_list" model="ir.ui.view">
        <field name="name">construction.subcontract.list</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-warning="state == 'active'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="task_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="contract_amount"/>
                <field name="retention_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_subcontract_form" model="ir.ui.view">
        <field name="name">construction.subcontract.form</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <form string="Subcontract">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_terminate" type="object" string="Terminate" invisible="state not in ('draft','active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="contract_amount"/>
                            <field name="retention_percent"/>
                            <field name="retention_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Scope of Work"><field name="scope" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_subcontract" model="ir.actions.act_window">
        <field name="name">Subcontracts</field>
        <field name="res_model">construction.subcontract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_construction_equipment_list" model="ir.ui.view">
        <field name="name">construction.equipment.assignment.list</field>
        <field name="model">construction.equipment.assignment</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'onsite'" decoration-success="state == 'returned'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="equipment_id"/>
                <field name="operator_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="actual_hours"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_equipment_form" model="ir.ui.view">
        <field name="name">construction.equipment.assignment.form</field>
        <field name="model">construction.equipment.assignment</field>
        <field name="arch" type="xml">
            <form string="Equipment Assignment">
                <header>
                    <button name="action_onsite" type="object" string="Mark On Site" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_return" type="object" string="Return" class="btn-primary" invisible="state != 'onsite'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="task_id"/>
                            <field name="equipment_id"/>
                            <field name="operator_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="hourly_rate"/>
                            <field name="planned_hours"/>
                            <field name="actual_hours"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_equipment" model="ir.actions.act_window">
        <field name="name">Equipment Assignments</field>
        <field name="res_model">construction.equipment.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
