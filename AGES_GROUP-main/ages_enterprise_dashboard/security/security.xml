<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ages_enterprise_dashboard" model="res.groups">
        <field name="name">AGES Enterprise Dashboard</field>
        <field name="comment">Open the AGES Enterprise Management Dashboard application.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Settings users who can install apps also get the dashboard app on Home. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ages_enterprise_dashboard'))]"/>
    </record>
</odoo>
