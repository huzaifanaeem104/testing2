<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ages_enterprise_dashboard" model="ir.actions.client">
        <field name="name">AGES Dashboard</field>
        <field name="tag">ages_enterprise_dashboard</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_ages_enterprise_dashboard_root"
              name="AGES Dashboard"
              action="action_ages_enterprise_dashboard"
              sequence="2"
              web_icon="ages_enterprise_dashboard,static/description/icon.png"
              groups="base.group_system,ages_enterprise_dashboard.group_ages_enterprise_dashboard"/>

    <record id="view_ages_dashboard_kpi_target_tree" model="ir.ui.view">
        <field name="name">ages.dashboard.kpi.target.list</field>
        <field name="model">ages.dashboard.kpi.target</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="kpi_key"/>
                <field name="target_value"/>
                <field name="company_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_ages_dashboard_kpi_target" model="ir.actions.act_window">
        <field name="name">KPI targets</field>
        <field name="res_model">ages.dashboard.kpi.target</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
