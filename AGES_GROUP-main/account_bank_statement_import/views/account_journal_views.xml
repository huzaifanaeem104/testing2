<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_statement_import" model="ir.ui.view">
        <field name="name">account.journal.form.statement.import</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="bank_statements_source" position="after">
                <div class="text-muted" invisible="type not in ('bank', 'cash', 'credit')">
                    Upload a statement file from the Accounting dashboard or the journal.
                </div>
            </field>
        </field>
    </record>
</odoo>
