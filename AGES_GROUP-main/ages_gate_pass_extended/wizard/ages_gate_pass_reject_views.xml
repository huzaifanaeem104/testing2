<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ages_gate_pass_reject_form" model="ir.ui.view">
        <field name="name">ages.gate.pass.reject.form</field>
        <field name="model">ages.gate.pass.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Gate Pass">
                <group>
                    <field name="gate_pass_id" readonly="1"/>
                    <field name="reason" placeholder="Reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
