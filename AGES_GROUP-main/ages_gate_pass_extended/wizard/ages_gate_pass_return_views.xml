<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_gate_pass_return_form" model="ir.ui.view">
        <field name="name">ages.gate.pass.return.form</field>
        <field name="model">ages.gate.pass.return</field>
        <field name="arch" type="xml">
            <form string="Return Items">
                <field name="rgp_id" invisible="1"/>
                <p>
                    Enter the quantity being physically returned today for each
                    item. This will create a new Inward Gate Pass linked to the
                    original Returnable Gate Pass — it must be posted (and
                    cleared by Security, if required) like any other Gate Pass.
                </p>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="rgp_line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="qty_remaining" readonly="1"/>
                        <field name="qty_to_return"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_return" type="object"
                            string="Create Return Gate Pass" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
