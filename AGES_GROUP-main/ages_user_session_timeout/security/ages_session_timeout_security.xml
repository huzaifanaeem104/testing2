<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ages_session_timeout" model="ir.module.category">
        <field name="name">Session Timeout</field>
        <field name="description">Configure per-user inactivity logout policies.</field>
        <field name="sequence">93</field>
    </record>

    <record id="group_session_timeout_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_ages_session_timeout"/>
        <field name="comment">Can set inactivity timeout policy, duration, and warning on users. Ordinary users cannot change their own timeout.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_session_timeout_manager'))]"/>
    </record>
</odoo>
