<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_login_as_any_user" model="ir.module.category">
        <field name="name">Login As Any User</field>
        <field name="description">Passwordless login as another user from the systray.</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_login_as_any_user" model="res.groups">
        <field name="name">Allow Login As Any User</field>
        <field name="category_id" ref="module_category_login_as_any_user"/>
        <field name="comment">Can switch into any user account without that user's password.</field>
    </record>

    <!-- Settings (Administration) users get the right automatically. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_login_as_any_user'))]"/>
    </record>
</odoo>
