<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="inside">
            <div t-if="props.isChatterAside"
                 class="ages_chatter_resize_handle"
                 title="Drag to resize chatter. Double-click to reset."
                 t-on-mousedown="agesOnResizeStart"
                 t-on-touchstart="agesOnResizeStart"
                 t-on-dblclick="agesOnResizeReset"/>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]" position="inside">
            <button class="btn btn-link text-action ages_chatter_hide_btn"
                    title="Hide Chatter"
                    aria-label="Hide Chatter"
                    t-on-click="agesHideChatter">
                <i class="fa fa-chevron-right" role="img"/>
            </button>
        </xpath>
    </t>
</templates>
