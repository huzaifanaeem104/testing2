<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_point_action" model="ir.actions.act_window">
        <field name="name">Control Points</field>
        <field name="res_model">quality.point</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="quality_check_action" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="quality_alert_action" model="ir.actions.act_window">
        <field name="name">Quality Alerts</field>
        <field name="res_model">quality.alert</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="quality_team_action" model="ir.actions.act_window">
        <field name="name">Quality Teams</field>
        <field name="res_model">quality.alert.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="quality_point_view_form" model="ir.ui.view">
        <field name="name">quality.point.form</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(quality_check_action)d" type="action" class="oe_stat_button" icon="fa-check"
                                context="{'search_default_point_id': id}">
                            <field name="check_count" widget="statinfo" string="Checks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="team_id"/>
                            <field name="test_type_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="picking_type_ids" widget="many2many_tags"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="product_category_ids" widget="many2many_tags"/>
                            <field name="measure_min" invisible="test_type != 'measure'"/>
                            <field name="measure_max" invisible="test_type != 'measure'"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Instructions for the operator..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quality_point_view_list" model="ir.ui.view">
        <field name="name">quality.point.list</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="test_type_id"/>
                <field name="picking_type_ids" widget="many2many_tags"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="team_id"/>
            </list>
        </field>
    </record>

    <record id="quality_check_view_form" model="ir.ui.view">
        <field name="name">quality.check.form</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="do_pass" type="object" string="Pass" class="btn-primary" invisible="quality_state != 'none'"/>
                    <button name="do_fail" type="object" string="Fail" class="btn-secondary" invisible="quality_state != 'none'"/>
                    <field name="quality_state" widget="statusbar" statusbar_visible="none,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_alerts" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="product_id"/>
                            <field name="picking_id"/>
                            <field name="test_type_id"/>
                            <field name="measure" invisible="test_type != 'measure'"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="control_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                        <field name="additional_note"/>
                        <field name="picture" widget="image"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quality_check_view_list" model="ir.ui.view">
        <field name="name">quality.check.list</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <list decoration-success="quality_state == 'pass'" decoration-danger="quality_state == 'fail'">
                <field name="name"/>
                <field name="title"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="quality_state"/>
                <field name="user_id"/>
                <field name="control_date"/>
            </list>
        </field>
    </record>

    <record id="quality_alert_view_form" model="ir.ui.view">
        <field name="name">quality.alert.form</field>
        <field name="model">quality.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="picking_id"/>
                            <field name="check_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Actions">
                            <group>
                                <field name="action_corrective"/>
                                <field name="action_preventive"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quality_alert_view_list" model="ir.ui.view">
        <field name="name">quality.alert.list</field>
        <field name="model">quality.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="stage_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="quality_alert_view_kanban" model="ir.ui.view">
        <field name="name">quality.alert.kanban</field>
        <field name="model">quality.alert</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="product_id"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold"><field name="name"/></div>
                        <div><field name="product_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="quality_team_view_form" model="ir.ui.view">
        <field name="name">quality.alert.team.form</field>
        <field name="model">quality.alert.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
