<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality" model="ir.module.category">
        <field name="name">Quality</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_quality_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_quality"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_quality_user'))]"/>
    </record>
    <record id="group_quality_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="quality_comp_rule" model="ir.rule">
        <field name="name">Quality records multi-company</field>
        <field name="model_id" ref="model_quality_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quality_check_comp_rule" model="ir.rule">
        <field name="name">Quality checks multi-company</field>
        <field name="model_id" ref="model_quality_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quality_alert_comp_rule" model="ir.rule">
        <field name="name">Quality alerts multi-company</field>
        <field name="model_id" ref="model_quality_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
