<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_mobilization_advance_list" model="ir.ui.view">
        <field name="name">ages.mobilization.advance.list</field>
        <field name="model">ages.mobilization.advance</field>
        <field name="arch" type="xml">
            <list string="Mobilization Received">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ages_mobilization_advance_form" model="ir.ui.view">
        <field name="name">ages.mobilization.advance.form</field>
        <field name="model">ages.mobilization.advance</field>
        <field name="arch" type="xml">
            <form string="Mobilization Received">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ages_mobilization_advance" model="ir.actions.act_window">
        <field name="name">Mobilization Received</field>
        <field name="res_model">ages.mobilization.advance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
