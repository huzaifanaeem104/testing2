<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="retention_report">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="currency" t-value="currency or company.currency_id"/>
                <t t-set="col_count" t-value="6"/>
                <t t-call="ages_custom_reports.ages_report_pdf_styles"/>

                <div class="ages-ledger-report ages-report-branded">
                    <t t-call="ages_custom_reports.ages_report_pdf_header"/>

                    <div class="report-meta">
                        <span class="meta-pair"><span class="meta-k">Period</span><span class="meta-v"><t t-esc="date_label"/></span></span>
                        <span class="meta-pair"><span class="meta-k">Contract State</span><span class="meta-v"><t t-esc="contract_state_label"/></span></span>
                        <span class="meta-pair"><span class="meta-k">Currency</span><span class="meta-v"><t t-esc="currency.name"/></span></span>
                    </div>

                    <t t-if="not lines">
                        <p style="text-align:center;padding:16px;color:#5c6b7f;">No retention journal items found.</p>
                    </t>

                    <t t-if="lines">
                        <table class="ledger-table">
                            <thead>
                                <tr>
                                    <th style="width:34%;">Client / Entry</th>
                                    <th style="width:10%;">Date</th>
                                    <th style="width:20%;">Account</th>
                                    <th class="col-amount text-end" style="width:12%;">Debit</th>
                                    <th class="col-amount text-end" style="width:12%;">Credit</th>
                                    <th class="col-amount text-end" style="width:12%;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines" t-as="line">
                                    <tr t-att-class="'group-row' if line['line_type'] in ('client', 'total') else ('subtotal-row' if line['line_type'] == 'contract' else 'data-row')">
                                        <td t-att-style="'padding-left: %spx;' % (8 + (line.get('level') or 0) * 12)">
                                            <t t-esc="line.get('name') or ''"/>
                                            <t t-if="line.get('running_bill_name')">
                                                <div style="font-size:10px;color:#5c6b7f;margin-top:2px;">
                                                    From running bill <t t-esc="line.get('running_bill_name')"/>
                                                </div>
                                            </t>
                                        </td>
                                        <td><t t-esc="line.get('date') or ''"/></td>
                                        <td><t t-esc="line.get('account_name') or ''"/></td>
                                        <td class="col-amount">
                                            <t t-if="line.get('debit')">
                                                <span t-out="line.get('debit', 0.0)"
                                                      t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </t>
                                        </td>
                                        <td class="col-amount">
                                            <t t-if="line.get('credit')">
                                                <span t-out="line.get('credit', 0.0)"
                                                      t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </t>
                                        </td>
                                        <td class="col-amount">
                                            <span t-out="line.get('balance', 0.0)"
                                                  t-att-class="'ages-ledger-negative' if line.get('balance', 0.0) &lt; 0 else ''"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
