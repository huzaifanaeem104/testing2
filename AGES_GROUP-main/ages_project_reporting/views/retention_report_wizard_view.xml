<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_retention_report_pdf" model="ir.actions.report">
        <field name="name">Retention Report</field>
        <field name="model">retention.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_project_reporting.retention_report</field>
        <field name="report_file">ages_project_reporting.retention_report</field>
        <field name="print_report_name">'Retention Report'</field>
        <field name="paperformat_id" ref="ages_custom_reports.paperformat_general_ledger"/>
    </record>

    <record id="action_report_retention_report_xlsx" model="ir.actions.report">
        <field name="name">Retention Report Excel</field>
        <field name="model">retention.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_project_reporting.retention_report_xlsx</field>
        <field name="report_file">ages_project_reporting.retention_report_xlsx</field>
        <field name="print_report_name">'Retention Report'</field>
    </record>

    <record id="action_retention_report_interactive" model="ir.actions.client">
        <field name="name">Retention Report</field>
        <field name="tag">ages_retention_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_retention_report"
              name="Retention Report"
              parent="menu_ages_reporting_projects"
              action="action_retention_report_interactive"
              sequence="20"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
