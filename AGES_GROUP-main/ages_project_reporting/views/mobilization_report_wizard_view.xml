<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mobilization_report_pdf" model="ir.actions.report">
        <field name="name">Mobilization Report</field>
        <field name="model">mobilization.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_project_reporting.mobilization_report</field>
        <field name="report_file">ages_project_reporting.mobilization_report</field>
        <field name="print_report_name">'Mobilization Report'</field>
        <field name="paperformat_id" ref="ages_custom_reports.paperformat_general_ledger"/>
    </record>

    <record id="action_report_mobilization_report_xlsx" model="ir.actions.report">
        <field name="name">Mobilization Report Excel</field>
        <field name="model">mobilization.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_project_reporting.mobilization_report_xlsx</field>
        <field name="report_file">ages_project_reporting.mobilization_report_xlsx</field>
        <field name="print_report_name">'Mobilization Report'</field>
    </record>

    <record id="action_mobilization_report_interactive" model="ir.actions.client">
        <field name="name">Mobilization Report</field>
        <field name="tag">ages_mobilization_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_mobilization_report"
              name="Mobilization Report"
              parent="menu_ages_reporting_projects"
              action="action_mobilization_report_interactive"
              sequence="10"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
