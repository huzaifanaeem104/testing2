<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_button_access_scan_wizard_form" model="ir.ui.view">
        <field name="name">button.access.scan.wizard.form</field>
        <field name="model">button.access.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Hide Buttons">
                <group>
                    <field name="model_id" options="{'no_create': True, 'no_open': True}"
                           readonly="scanned"/>
                    <field name="user_ids" widget="many2many_tags"
                           readonly="context.get('lock_user_field')"
                           placeholder="Select the user(s) to hide buttons from..."/>
                    <field name="group_ids" widget="many2many_tags"
                           readonly="context.get('lock_group_field')"
                           placeholder="Select the group(s) to hide buttons from..."/>
                </group>
                <group string="Buttons Found" invisible="not scanned">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="line_model_id" optional="show"/>
                            <field name="button_type"/>
                            <field name="button_string"/>
                            <field name="technical_name"/>
                            <field name="view_types"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_scan" type="object" string="Scan Buttons"
                            class="btn-primary" invisible="scanned"/>
                    <button name="action_apply" type="object"
                            string="Hide Selected Buttons"
                            class="btn-primary" invisible="not scanned"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_button_access_scan_wizard" model="ir.actions.act_window">
        <field name="name">Hide Buttons</field>
        <field name="res_model">button.access.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
