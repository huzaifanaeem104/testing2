<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ages_civil_monthly_bill_wizard_form" model="ir.ui.view">
        <field name="name">ages.civil.monthly.bill.wizard.form</field>
        <field name="model">ages.civil.monthly.bill.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Monthly Bill">
                <group>
                    <group>
                        <field name="purchase_id" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="bill_date"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group string="Received slips to include">
                    <field name="available_slip_ids" invisible="1"/>
                    <field name="slip_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="truck_no"/>
                            <field name="first_measurement_slip"/>
                            <field name="qty_total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_create_bill" type="object"
                            string="Create Bill" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
