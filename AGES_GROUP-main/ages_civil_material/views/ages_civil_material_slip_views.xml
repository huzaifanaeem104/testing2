<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ages_civil_material_slip_tree" model="ir.ui.view">
        <field name="name">ages.civil.material.slip.list</field>
        <field name="model">ages.civil.material.slip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="truck_no"/>
                <field name="first_measurement_slip"/>
                <field name="qty_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ages_civil_material_slip_form" model="ir.ui.view">
        <field name="name">ages.civil.material.slip.form</field>
        <field name="model">ages.civil.material.slip</field>
        <field name="arch" type="xml">
            <form string="Civil Material Slip">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_grn" type="object" string="Create GRN"
                            class="btn-primary"
                            invisible="state not in ('confirmed', 'received') or picking_id"/>
                    <button name="action_create_gate_pass" type="object" string="Create Gate Pass"
                            invisible="state not in ('confirmed', 'received') or not picking_id or gate_pass_id"/>
                    <button name="action_mark_received" type="object" string="Mark Received"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('billed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,received,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">GRN</span>
                            </div>
                        </button>
                        <button name="action_view_gate_pass" type="object"
                                class="oe_stat_button" icon="fa-id-card"
                                invisible="not gate_pass_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Gate Pass</span>
                            </div>
                        </button>
                        <button name="action_view_bill" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not bill_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bill</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="arrival_time" widget="float_time" readonly="state != 'draft'"/>
                            <field name="truck_no" readonly="state != 'draft'"/>
                            <field name="first_measurement_slip" readonly="state != 'draft'"/>
                            <field name="qty_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Measurements" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="length"/>
                                    <field name="breadth"/>
                                    <field name="height"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="product_uom_id"/>
                                    <field name="rate"/>
                                    <field name="amount"/>
                                    <field name="remarks"/>
                                    <field name="purchase_line_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="remarks" readonly="state != 'draft'"/>
                            <group>
                                <field name="picking_id" readonly="1"/>
                                <field name="gate_pass_id" readonly="1"/>
                                <field name="bill_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ages_civil_material_slip_search" model="ir.ui.view">
        <field name="name">ages.civil.material.slip.search</field>
        <field name="model">ages.civil.material.slip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="truck_no"/>
                <field name="first_measurement_slip"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="unbilled" string="Unbilled Received"
                        domain="[('state', '=', 'received'), ('bill_id', '=', False)]"/>
                <group>
                    <filter name="group_po" string="Purchase Order"
                            context="{'group_by': 'purchase_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ages_civil_material_slip" model="ir.actions.act_window">
        <field name="name">Civil Material Slips</field>
        <field name="res_model">ages.civil.material.slip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Civil Material Slip for each truck arrival.
            </p>
            <p>
                Link it to a Civil Material PO, enter L×B×H, then Create GRN and Gate Pass.
                Bill all slips together at month end from the PO.
            </p>
        </field>
    </record>
</odoo>
