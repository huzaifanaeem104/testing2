<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_running_bill_list_contract" model="ir.ui.view">
        <field name="name">ages.running.bill.list.contract</field>
        <field name="model">ages.running.bill</field>
        <field name="inherit_id" ref="ages_contracts_menu.view_ages_running_bill_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="contract_id"/>
            </xpath>
        </field>
    </record>

