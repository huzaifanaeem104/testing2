<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_location_form_ages_contract" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.ages.contract</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="ages_contract_id" readonly="1"/>
                <field name="ages_project_id" readonly="1"/>
                <field name="ages_analytic_account_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
