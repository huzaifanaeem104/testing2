<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_project_form_ages_contract" model="ir.ui.view">
        <field name="name">project.project.form.inherit.ages.contract</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ages_contract_id" readonly="1"/>
                <field name="ages_location_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
