<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_secondary_uom_list" model="ir.ui.view">
        <field name="name">ages.secondary.uom.list</field>
        <field name="model">ages.secondary.uom</field>
        <field name="arch" type="xml">
            <list string="Secondary UOM" editable="bottom">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ages_secondary_uom_form" model="ir.ui.view">
        <field name="name">ages.secondary.uom.form</field>
        <field name="model">ages.secondary.uom</field>
        <field name="arch" type="xml">
            <form string="Secondary UOM">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ages_secondary_uom" model="ir.actions.act_window">
        <field name="name">Secondary UOM</field>
        <field name="res_model">ages.secondary.uom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ages_secondary_uom"
              name="Secondary UOM"
              parent="project.menu_project_config"
              action="action_ages_secondary_uom"
              sequence="55"
              groups="project.group_project_manager"/>

</odoo>
