<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ages_custom_reports.AgesTaxReturnReport">
        <div class="o_action o_ages_bs_report o_ages_tr_report account_report" t-ref="root">
            <Layout display="display">
                <t t-set-slot="control-panel-create-button">
                    <div class="o_ages_tr_header_btns d-inline-flex align-items-center gap-1">
                        <button class="btn btn-primary text-nowrap" t-on-click="onPrintPdf">
                            PDF
                        </button>
                        <button class="btn btn-secondary text-nowrap" t-on-click="onPrintExcel">
                            XLSX
                        </button>
                        <button class="btn btn-secondary text-nowrap" t-on-click="onClosingEntry">
                            Closing Entry
                        </button>
                    </div>
                </t>

                <t t-set-slot="layout-actions">
                    <div class="o_ages_report_filters_area">
                        <div class="d-flex gap-1 flex-wrap align-items-center o_ages_report_filters">
                            <button type="button" class="btn btn-secondary" t-on-click="(ev) => this.toggleFilterMenu('date', ev)">
                                <i class="fa fa-calendar me-1"/>
                                <t t-esc="dateRangeFilterLabel"/>
                            </button>
                            <button type="button"
                                    class="btn btn-secondary"
                                    t-att-class="{ 'o_ages_filter_selected': state.comparison }"
                                    t-on-click="onToggleComparison">
                                <i class="fa fa-percent me-1"/>
                                Comparison
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="(ev) => this.toggleFilterMenu('entries', ev)">
                                <i class="fa fa-sliders me-1"/>
                                <t t-esc="targetMoveFilterLabel"/>
                            </button>
                            <button type="button" class="btn btn-secondary o_ages_report_currency_pill">
                                <i class="fa fa-file me-1"/>
                                Report: <t t-esc="state.reportName"/>
                            </button>
                            <button type="button" class="btn btn-secondary o_ages_report_currency_pill">
                                In <t t-esc="state.currencySymbol"/>
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="clearFilters">
                                Clear
                            </button>
                            <button type="button" class="btn btn-secondary o_ages_report_gear_btn" title="Report options" t-on-click="(ev) => this.toggleFilterMenu('options', ev)">
                                <i class="fa fa-fw fa-cog"/>
                            </button>
                            <span t-if="state.loading" class="text-muted small ms-1">
                                <i class="fa fa-spinner fa-spin"/>
                            </span>
                        </div>
                        <div t-if="state.openMenu === 'date'" class="o_ages_report_dropdown" t-att-style="filterMenuStyle()">
                            <div class="dropdown-item date d-flex justify-content-between align-items-center">
                                <label class="mb-0">From</label>
                                <input type="date" class="o_ages_report_date_input" t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                            </div>
                            <div class="dropdown-item date d-flex justify-content-between align-items-center">
                                <label class="mb-0">To</label>
                                <input type="date" class="o_ages_report_date_input" t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                            </div>
                        </div>
                        <div t-if="state.openMenu === 'entries'" class="o_ages_report_dropdown" t-att-style="filterMenuStyle()">
                            <button type="button" class="dropdown-item" t-att-class="{ selected: state.targetMove === 'posted' }" t-on-click="() => this.setTargetMove('posted')">Posted Entries</button>
                            <button type="button" class="dropdown-item" t-att-class="{ selected: state.targetMove === 'all' }" t-on-click="() => this.setTargetMove('all')">All Entries</button>
                        </div>
                        <div t-if="state.openMenu === 'options'" class="o_ages_report_dropdown" t-att-style="filterMenuStyle()">
                            <button type="button" class="dropdown-item" t-att-class="{ selected: state.unfoldAll }" t-on-click="() => this.toggleUnfoldAllOption()">Unfold All</button>
                        </div>
                    </div>
                </t>

                <div class="o_ages_bs_content">
                    <t t-if="state.warnings.length">
                        <div class="o_ages_bs_warnings">
                            <t t-foreach="state.warnings" t-as="warning" t-key="warning_index">
                                <div class="alert alert-info text-center mb-0">
                                    <t t-foreach="warningParts(warning)" t-as="part" t-key="part_index">
                                        <a t-if="part.link"
                                           href="#"
                                           class="alert-link"
                                           t-on-click.prevent="() => this.onWarningClick(warning)">
                                            <t t-esc="part.text"/>
                                        </a>
                                        <t t-else="" t-esc="part.text"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>

                    <div class="o_ages_tr_sheet mx-auto fit-content">
                        <table class="table table-borderless table-hover o_ages_tr_table mb-0">
                            <thead class="sticky">
                                <tr class="o_ages_tr_header-group">
                                    <th class="o_ages_tr_label_col" rowspan="2"/>
                                    <th class="o_ages_tr_period_col text-center" colspan="2">
                                        <t t-esc="state.periodLabel"/>
                                    </th>
                                    <t t-if="state.comparison">
                                        <th class="o_ages_tr_period_col text-center" colspan="2">
                                            <t t-esc="state.comparisonLabel"/>
                                        </th>
                                        <th class="o_ages_tr_amount_col text-center" rowspan="2">%</th>
                                    </t>
                                </tr>
                                <tr class="o_ages_tr_header-sub">
                                    <th class="o_ages_tr_amount_col text-end">base</th>
                                    <th class="o_ages_tr_amount_col text-end">Tax Amount</th>
                                    <t t-if="state.comparison">
                                        <th class="o_ages_tr_amount_col text-end">base</th>
                                        <th class="o_ages_tr_amount_col text-end">Tax Amount</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="visibleLines" t-as="line" t-key="line.id">
                                    <tr t-att-class="rowClass(line) + (line.tag_ids and line.tag_ids.length ? ' o_ages_report_row' : '')">
                                        <td class="o_ages_tr_label_col"
                                            t-att-style="'padding-left: ' + (8 + line.level * 16) + 'px'">
                                            <span t-if="line.foldable"
                                                  class="o_ages_bs_caret"
                                                  t-on-click="() => this.toggleFold(line)">
                                                <i t-att-class="isExpanded(line) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                            </span>
                                            <span t-else="" class="o_ages_bs_caret-spacer"/>
                                            <span class="o_ages_line_label">
                                                <span t-esc="line.name"/>
                                                <ReportLineMenu t-if="getLineMenuItems(line).length"
                                                                items="getLineMenuItems(line)"/>
                                            </span>
                                        </td>
                                        <td class="o_ages_tr_amount_col text-end"
                                            t-att-class="amountClass(line.show_base ? line.base : false) + (line.show_base and line.tag_ids and line.tag_ids.length ? ' o_ages_tr_clickable' : '')"
                                            t-on-click="() => line.show_base and this.openTaxLines(line, 'base')">
                                            <t t-if="line.show_base" t-esc="formatAmount(line.base)"/>
                                        </td>
                                        <td class="o_ages_tr_amount_col text-end"
                                            t-att-class="amountClass(line.show_tax ? line.tax : false) + (line.show_tax and line.tag_ids and line.tag_ids.length ? ' o_ages_tr_clickable' : '')"
                                            t-on-click="() => line.show_tax and this.openTaxLines(line, 'tax')">
                                            <t t-if="line.show_tax" t-esc="formatAmount(line.tax)"/>
                                        </td>
                                        <t t-if="state.comparison">
                                            <td class="o_ages_tr_amount_col text-end"
                                                t-att-class="amountClass(line.show_base ? line.comp_base : false)">
                                                <t t-if="line.show_base" t-esc="formatAmount(line.comp_base)"/>
                                            </td>
                                            <td class="o_ages_tr_amount_col text-end"
                                                t-att-class="amountClass(line.show_tax ? line.comp_tax : false)">
                                                <t t-if="line.show_tax" t-esc="formatAmount(line.comp_tax)"/>
                                            </td>
                                            <td class="o_ages_tr_amount_col text-end"
                                                t-att-class="amountClass(line.show_tax ? line.pct_tax : false)">
                                                <t t-if="line.show_tax" t-esc="formatPercent(line.pct_tax)"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

</templates>
