<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ages_report_pdf_styles">
        <style type="text/css">
            html, body {
                height: auto !important;
                min-height: 0 !important;
                margin: 0;
                padding: 0;
            }
            .article {
                padding: 0 !important;
                margin: 0 !important;
            }
            .ages-report-branded {
                font-family: Helvetica, Arial, sans-serif;
                color: #1a2332;
                font-size: 15px;
                line-height: 1.5;
            }
            .ages-report-header {
                margin-bottom: 12px;
                border: none !important;
                padding-bottom: 0;
                outline: none;
                box-shadow: none;
            }
            .ages-report-header-row {
                width: 100%;
                margin-bottom: 10px;
                border: none !important;
                outline: none !important;
                background: transparent !important;
            }
            .ages-report-header-row:after {
                content: "";
                display: table;
                clear: both;
            }
            .ages-report-header-brand {
                float: left;
                width: 64%;
                border: none !important;
                background: transparent !important;
            }
            .ages-report-company-name {
                font-size: 24px;
                font-weight: bold;
                color: #8b1a1a;
                letter-spacing: 0.02em;
                margin-bottom: 5px;
            }
            .ages-report-company-address {
                font-size: 15px;
                color: #5c4a4a;
                margin-bottom: 3px;
            }
            .ages-report-company-email {
                font-size: 15px;
                color: #8b1a1a;
            }
            .ages-report-header-logo {
                float: right;
                width: 34%;
                text-align: right;
                border: none !important;
                background: transparent !important;
            }
            .ages-report-logo {
                max-height: 88px;
                max-width: 260px;
                border: none !important;
            }
            .ages-report-title-bar {
                clear: both;
                background: transparent;
                color: #8b1a1a;
                padding: 0 0 8px;
                border: none !important;
                border-top: none !important;
                border-bottom: 1px solid #8b1a1a !important;
            }
            .ages-report-title {
                font-size: 22px;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #8b1a1a;
            }
            .ages-report-subtitle {
                font-size: 13px;
                font-weight: normal;
                color: #5c4a4a;
                margin-top: 4px;
            }
            .ages-report-branded .ages-bs-meta,
            .ages-report-branded .ages-gl-meta,
            .ages-report-branded .ages-pl-meta,
            .ages-report-branded .ages-cf-meta,
            .ages-report-branded .ages-es-meta,
            .ages-report-branded .ages-ja-meta,
            .ages-report-branded .report-meta {
                display: block;
                margin: 2px 0 12px;
                padding: 0;
                font-size: 11px;
                color: #5c4a4a;
                width: 100%;
                border: 0 !important;
                border-style: none !important;
                outline: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            .ages-report-branded .report-meta .meta-pair {
                display: inline-block;
                margin: 0 18px 4px 0;
                padding: 0;
                border: 0 !important;
                background: transparent !important;
                white-space: nowrap;
            }
            .ages-report-branded .report-meta .meta-k {
                display: inline;
                color: #8b1a1a;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-right: 6px;
                border: 0 !important;
                background: transparent !important;
            }
            .ages-report-branded .report-meta .meta-v {
                display: inline;
                color: #1a2332;
                font-weight: normal;
                border: 0 !important;
                background: transparent !important;
            }
            /* Global table typography — data tables only */
            .ages-report-branded table th {
                font-size: 15px !important;
                padding: 11px 10px !important;
                font-weight: bold;
            }
            .ages-report-branded table td {
                font-size: 14px !important;
                padding: 8px 10px !important;
            }
            .ages-report-branded .report-meta .meta-v {
                font-size: 11px !important;
                padding: 0 !important;
            }
            /* Low-ink table headers — white fill, maroon text/border */
            .ages-report-branded .ages-bs-table th,
            .ages-report-branded .ages-gl-table th,
            .ages-report-branded .fin-table th,
            .ages-report-branded .ages-pnl-table th,
            .ages-report-branded .ages-cf-table th,
            .ages-report-branded .ages-es-table th,
            .ages-report-branded .ages-ja-table th,
            .ages-report-branded .ledger-table thead th {
                background: #ffffff !important;
                color: #8b1a1a !important;
                border-color: #8b1a1a !important;
            }
            /* Section / group rows — white with maroon accent line */
            .ages-report-branded .ages-bs-table tr.section td,
            .ages-report-branded .ages-cf-table tr.section td,
            .ages-report-branded .ages-es-table tr.section td,
            .ages-report-branded .fin-table tr.section td {
                background: #ffffff !important;
                color: #8b1a1a !important;
                border-top-color: #8b1a1a !important;
            }
            .ages-report-branded .ages-bs-table tr.total td,
            .ages-report-branded .ages-gl-table tr.total td,
            .ages-report-branded .fin-table tr.total td,
            .ages-report-branded .ages-pnl-table tr.total td,
            .ages-report-branded .ages-cf-table tr.total td {
                background: #ffffff !important;
                border-top-color: #8b1a1a !important;
            }
            .ages-report-branded .ages-bs-warning,
            .ages-report-branded .ages-gl-warning,
            .ages-report-branded .ages-pl-warning,
            .ages-report-branded .ages-cf-warning,
            .ages-report-branded .ages-es-warning {
                font-size: 13px !important;
                padding: 10px 12px !important;
            }
            .ages-report-branded .ages-pdl-report .group-row td {
                background: #ffffff !important;
                color: #8b1a1a !important;
                border-top-color: #8b1a1a !important;
            }
            .ages-report-branded .ages-pdl-report .grand-total-table .gt-head {
                background: #ffffff !important;
                color: #8b1a1a !important;
            }

            /* ── Financial reports (Balance Sheet / P&amp;L / Cash Flow) — clean portrait layout ── */
            .ages-fin-report {
                font-family: Helvetica, Arial, sans-serif;
                color: #1a2332;
                font-size: 13px;
                line-height: 1.45;
            }
            .ages-fin-report .report-meta {
                display: block;
                width: 100%;
                margin: 0 0 10px 0;
                padding: 0;
                border: 0 !important;
                outline: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            .ages-fin-report .report-meta .meta-pair {
                display: inline-block;
                margin: 0 18px 4px 0;
                border: 0 !important;
                background: transparent !important;
            }
            .ages-fin-report .report-meta .meta-k {
                display: inline;
                white-space: nowrap;
                background: transparent;
                color: #8b1a1a;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-right: 6px;
                font-size: 11px;
            }
            .ages-fin-report .report-meta .meta-v {
                display: inline;
                color: #1a2332;
                font-weight: normal;
                font-size: 11px;
            }
            .ages-fin-report .fin-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin: 0;
            }
            .ages-fin-report .fin-table thead th {
                background: #ffffff !important;
                color: #8b1a1a !important;
                font-size: 13px !important;
                text-transform: uppercase;
                font-weight: bold;
                padding: 10px 8px !important;
                border: 1px solid #8b1a1a;
                vertical-align: middle;
            }
            .ages-fin-report .fin-table thead th.label-col {
                text-align: left;
                width: 76%;
            }
            .ages-fin-report .fin-table thead th.amount-col {
                text-align: right;
                width: 24%;
            }
            .ages-fin-report .fin-table tbody td {
                padding: 7px 8px !important;
                border: 1px solid #eed6da;
                vertical-align: middle;
                font-size: 14px !important;
                line-height: 1.4;
                word-wrap: break-word;
            }
            .ages-fin-report .fin-table td.fin-label {
                text-align: left;
                color: #1a2332;
            }
            .ages-fin-report .fin-table td.col-amount {
                text-align: right !important;
                white-space: nowrap;
                font-size: 13px !important;
                font-weight: 600;
            }
            .ages-fin-report .fin-table tr.section td {
                background: #ffffff !important;
                color: #8b1a1a !important;
                font-weight: bold;
                font-size: 14px !important;
                border-top: 2px solid #8b1a1a;
            }
            .ages-fin-report .fin-table tr.group td {
                font-weight: 600;
                color: #495057;
                background: #ffffff !important;
            }
            .ages-fin-report .fin-table tr.group.lvl-0 td,
            .ages-fin-report .fin-table tr.group.lvl-1 td,
            .ages-fin-report .fin-table tr.group.lvl-2 td {
                background: #f8f9fa !important;
                border-top: 1px solid #dee2e6;
            }
            .ages-fin-report .fin-table tr.total td {
                background: #ffffff !important;
                font-weight: bold;
                color: #8b1a1a !important;
                font-size: 14px !important;
                border-top: 1px solid #8b1a1a;
            }
            .ages-fin-report .fin-table tr.account td,
            .ages-fin-report .fin-table tr.expression td {
                font-weight: normal;
                color: #333333;
                background: #ffffff !important;
            }
            .ages-fin-negative {
                color: #c0392b !important;
            }
            .ages-fin-zero {
                color: #adb5bd !important;
            }

            /* ── Ledger reports (Partner / General / Project Directory style) ── */
            .ages-ledger-report {
                font-family: Helvetica, Arial, sans-serif;
                color: #1a2332;
                font-size: 13px;
                line-height: 1.45;
            }
            .ages-ledger-report .report-meta {
                display: block;
                width: 100%;
                margin: 0 0 10px 0;
                padding: 0;
                border: 0 !important;
                outline: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            .ages-ledger-report .report-meta .meta-pair {
                display: inline-block;
                margin: 0 18px 4px 0;
                border: 0 !important;
                background: transparent !important;
            }
            .ages-ledger-report .report-meta .meta-k {
                display: inline;
                white-space: nowrap;
                background: transparent;
                color: #8b1a1a;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-right: 6px;
                font-size: 11px;
            }
            .ages-ledger-report .report-meta .meta-v {
                display: inline;
                color: #1a2332;
                font-weight: normal;
                font-size: 11px;
            }
            .ages-ledger-report .ledger-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin: 0;
                background: #ffffff;
                border: 1.5px solid #8b1a1a;
            }
            .ages-ledger-report .ledger-table thead {
                display: table-header-group;
            }
            .ages-ledger-report .ledger-table thead th {
                background: #ffffff !important;
                color: #8b1a1a !important;
                font-size: 12px !important;
                text-transform: uppercase;
                font-weight: bold;
                padding: 8px 6px !important;
                border: 1.5px solid #8b1a1a;
                text-align: left;
                vertical-align: middle;
            }
            .ages-ledger-report .ledger-table thead th.text-end {
                text-align: right;
            }
            .ages-ledger-report .ledger-table tbody td {
                padding: 6px 6px !important;
                border: 1px solid #a8b0ba;
                vertical-align: top;
                font-size: 12px !important;
                line-height: 1.35;
                word-wrap: break-word;
                overflow-wrap: anywhere;
                background: #ffffff;
            }
            .ages-ledger-report .ledger-table tbody tr.data-row:nth-child(even) td {
                background: #ffffff;
            }
            .ages-ledger-report .ledger-table .group-row td {
                background: #ffffff !important;
                color: #8b1a1a !important;
                font-weight: bold;
                font-size: 13px !important;
                padding: 8px 8px !important;
                border-top: 2px solid #8b1a1a;
                page-break-after: avoid;
            }
            .ages-ledger-report .ledger-table .initial-row td {
                background: #ffffff;
                font-style: italic;
                color: #5c6b7f;
            }
            .ages-ledger-report .ledger-table .subtotal-row td {
                background: #ffffff !important;
                font-weight: bold;
                font-size: 13px !important;
                border-top: 1px solid #8b1a1a;
                color: #8b1a1a;
                page-break-before: avoid;
            }
            .ages-ledger-report .ledger-table .subtotal-row td.subtotal-label {
                text-align: right !important;
                white-space: nowrap;
            }
            .ages-ledger-report .ledger-table .col-desc {
                white-space: normal !important;
                word-wrap: break-word;
                overflow-wrap: anywhere;
                hyphens: auto;
            }
            .ages-ledger-report .ledger-table .ages-ledger-meta {
                color: #6c757d;
                font-size: 10px !important;
            }
            .ages-ledger-report .ledger-table .col-amount {
                text-align: right !important;
                white-space: nowrap;
                overflow: hidden;
                font-size: 13px !important;
                font-weight: 600;
                font-variant-numeric: tabular-nums;
            }
            .ages-ledger-report .ledger-table .col-amount span {
                display: inline-block;
                max-width: 100%;
                font-size: 13px !important;
            }
            .ages-ledger-report .ledger-table .ages-ledger-badge {
                display: inline-block;
                margin-left: 5px;
                padding: 0 3px;
                border: 1px solid #c5c5c5;
                border-radius: 2px;
                color: #8a8a8a;
                font-size: 9px !important;
                font-weight: 400;
                font-style: normal;
                line-height: 1.3;
                white-space: nowrap;
                vertical-align: middle;
            }
            .ages-ledger-report .grand-total-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
                border: 1px solid #8b1a1a;
                page-break-inside: avoid;
                background: #ffffff;
            }
            .ages-ledger-report .grand-total-table td {
                padding: 10px 8px;
                text-align: center;
                border: 1px solid #a8b0ba;
                vertical-align: middle;
                background: #ffffff;
            }
            .ages-ledger-report .grand-total-table .gt-head {
                background: #ffffff !important;
                color: #8b1a1a !important;
                font-weight: bold;
                text-transform: uppercase;
                font-size: 13px !important;
                border-bottom: 2px solid #8b1a1a;
            }
            .ages-ledger-report .grand-total-table .gt-label {
                color: #5c6b7f;
                font-weight: bold;
                text-transform: uppercase;
                font-size: 10px;
            }
            .ages-ledger-report .grand-total-table .gt-value {
                font-size: 15px;
                font-weight: bold;
                color: #8b1a1a;
            }
            .ages-ledger-negative {
                color: #c0392b !important;
            }
        </style>
    </template>

    <template id="ages_report_ledger_grand_total">
        <table t-if="grand_total" class="grand-total-table">
            <tr>
                <td class="gt-head" colspan="3">Report Grand Total</td>
            </tr>
            <tr>
                <td>
                    <div class="gt-label">Total Debit</div>
                    <div class="gt-value">
                        <span t-esc="pdf_format_amount(grand_total.get('debit', 0.0))"/>
                    </div>
                </td>
                <td>
                    <div class="gt-label">Total Credit</div>
                    <div class="gt-value">
                        <span t-esc="pdf_format_amount(grand_total.get('credit', 0.0))"/>
                    </div>
                </td>
                <td>
                    <div class="gt-label">Net Balance</div>
                    <div class="gt-value">
                        <span t-esc="pdf_format_amount(grand_total.get('balance', 0.0))"
                              t-att-class="'ages-ledger-negative' if grand_total.get('balance', 0.0) &lt; 0 else ''"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="ages_report_hierarchy_row">
        <tr t-att-class="line.get('pdf_row_class') or line['line_type']">
            <td class="fin-label"
                t-att-style="'padding-left: %spx;' % (line.get('pdf_indent_px') or (8 + line.get('level', 0) * 14))">
                <t t-esc="line['name']"/>
            </td>
            <td class="col-amount">
                <span t-out="line['balance']"
                      t-att-class="'ages-fin-negative' if line['balance'] &lt; 0 else ('ages-fin-zero' if line['balance'] == 0 else '')"
                      t-options='{"widget": "monetary", "display_currency": currency}'/>
            </td>
        </tr>
    </template>

    <template id="ages_report_pdf_header">
        <div class="ages-report-header">
            <div class="ages-report-header-row">
                <div class="ages-report-header-brand">
                    <div class="ages-report-company-name" t-esc="ages_company_name"/>
                    <div class="ages-report-company-address" t-esc="ages_company_address"/>
                    <div class="ages-report-company-email" t-esc="ages_company_email"/>
                </div>
                <div class="ages-report-header-logo">
                    <img t-if="ages_logo"
                         t-att-src="'data:image/png;base64,%s' % ages_logo"
                         class="ages-report-logo"
                         alt="AGES Logo"/>
                </div>
            </div>
            <div class="ages-report-title-bar">
                <div class="ages-report-title" t-esc="report_title"/>
                <div t-if="report_subtitle" class="ages-report-subtitle" t-esc="report_subtitle"/>
            </div>
        </div>
    </template>

</odoo>
