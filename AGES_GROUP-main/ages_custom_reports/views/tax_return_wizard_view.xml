<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_tax_return" model="report.paperformat">
        <field name="name">Tax Return A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_tax_return_pdf" model="ir.actions.report">
        <field name="name">Tax Return</field>
        <field name="model">tax.return.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_custom_reports.tax_return_report</field>
        <field name="report_file">ages_custom_reports.tax_return_report</field>
        <field name="paperformat_id" ref="paperformat_tax_return"/>
    </record>

    <record id="action_report_tax_return_xlsx" model="ir.actions.report">
        <field name="name">Tax Return Excel</field>
        <field name="model">tax.return.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_custom_reports.tax_return_xlsx</field>
        <field name="report_file">ages_custom_reports.tax_return_xlsx</field>
    </record>

    <record id="action_tax_return_interactive" model="ir.actions.client">
        <field name="name">Tax Return</field>
        <field name="tag">ages_tax_return_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_tax_return_report"
              name="Tax Return"
              parent="menu_ages_reporting_taxes"
              action="action_tax_return_interactive"
              sequence="10"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
