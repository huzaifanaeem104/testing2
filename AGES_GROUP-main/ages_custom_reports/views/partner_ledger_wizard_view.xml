<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_partner_ledger_pdf" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">partner.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_custom_reports.partner_ledger_report</field>
        <field name="report_file">ages_custom_reports.partner_ledger_report</field>
        <field name="paperformat_id" ref="paperformat_general_ledger"/>
    </record>

    <record id="action_report_partner_ledger_xlsx" model="ir.actions.report">
        <field name="name">Partner Ledger Excel</field>
        <field name="model">partner.ledger.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_custom_reports.partner_ledger_xlsx</field>
        <field name="report_file">ages_custom_reports.partner_ledger_xlsx</field>
    </record>

    <record id="action_partner_ledger_interactive" model="ir.actions.client">
        <field name="name">Partner Ledger</field>
        <field name="tag">ages_partner_ledger_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_partner_ledger_report"
              name="Partner Ledger"
              parent="menu_ages_reporting_partners"
              action="action_partner_ledger_interactive"
              sequence="10"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
