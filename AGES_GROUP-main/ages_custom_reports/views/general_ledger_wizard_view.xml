<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_general_ledger" model="report.paperformat">
        <field name="name">General Ledger A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_general_ledger_pdf" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">general.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_custom_reports.general_ledger_report</field>
        <field name="report_file">ages_custom_reports.general_ledger_report</field>
        <field name="paperformat_id" ref="paperformat_general_ledger"/>
    </record>

    <record id="action_report_general_ledger_xlsx" model="ir.actions.report">
        <field name="name">General Ledger Excel</field>
        <field name="model">general.ledger.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_custom_reports.general_ledger_xlsx</field>
        <field name="report_file">ages_custom_reports.general_ledger_xlsx</field>
    </record>

    <record id="action_general_ledger_interactive" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">ages_general_ledger_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_general_ledger_report"
              name="General Ledger"
              parent="menu_ages_reporting_ledgers"
              action="action_general_ledger_interactive"
              sequence="20"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
