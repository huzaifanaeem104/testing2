<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_balance_sheet" model="report.paperformat">
        <field name="name">Balance Sheet A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_balance_sheet_pdf" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">balance.sheet.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_custom_reports.balance_sheet_report</field>
        <field name="report_file">ages_custom_reports.balance_sheet_report</field>
        <field name="paperformat_id" ref="paperformat_balance_sheet"/>
    </record>

    <record id="action_report_balance_sheet_xlsx" model="ir.actions.report">
        <field name="name">Balance Sheet Excel</field>
        <field name="model">balance.sheet.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_custom_reports.balance_sheet_xlsx</field>
        <field name="report_file">ages_custom_reports.balance_sheet_xlsx</field>
    </record>

    <record id="action_balance_sheet_interactive" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">ages_balance_sheet_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_balance_sheet_report"
              name="Balance Sheet"
              parent="menu_ages_reporting_statements"
              action="action_balance_sheet_interactive"
              sequence="10"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
