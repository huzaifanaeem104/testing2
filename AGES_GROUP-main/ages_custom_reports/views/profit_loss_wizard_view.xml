<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_profit_loss" model="report.paperformat">
        <field name="name">Profit and Loss A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_profit_loss_pdf" model="ir.actions.report">
        <field name="name">Profit and Loss</field>
        <field name="model">profit.loss.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ages_custom_reports.profit_loss_report</field>
        <field name="report_file">ages_custom_reports.profit_loss_report</field>
        <field name="paperformat_id" ref="paperformat_profit_loss"/>
    </record>

    <record id="action_report_profit_loss_xlsx" model="ir.actions.report">
        <field name="name">Profit and Loss Excel</field>
        <field name="model">profit.loss.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ages_custom_reports.profit_loss_xlsx</field>
        <field name="report_file">ages_custom_reports.profit_loss_xlsx</field>
    </record>

    <record id="action_profit_loss_interactive" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">ages_profit_loss_report</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_profit_loss_report"
              name="Profit and Loss"
              parent="menu_ages_reporting_statements"
              action="action_profit_loss_interactive"
              sequence="20"
              groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
