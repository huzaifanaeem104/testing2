<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tax_return_activity_type" model="mail.activity.type">
        <field name="name">Tax Return</field>
        <field name="summary">Tax Return</field>
        <field name="category">default</field>
        <field name="res_model">account.journal</field>
        <field name="chaining_type">suggest</field>
        <field name="keep_done" eval="True"/>
    </record>

    <record id="ir_cron_tax_return_reminder" model="ir.cron">
        <field name="name">Tax Return: create period reminders</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_ensure_tax_return_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
