<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_presence" model="ir.cron">
        <field name="name">AGES User Presence: Refresh stale sessions</field>
        <field name="model_id" ref="model_ages_user_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_presence()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_gc_presence" model="ir.cron">
        <field name="name">AGES User Presence: Garbage-collect history</field>
        <field name="model_id" ref="model_ages_user_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_presence()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
