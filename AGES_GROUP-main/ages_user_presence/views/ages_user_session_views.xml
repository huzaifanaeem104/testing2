<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ages_user_session_list" model="ir.ui.view">
        <field name="name">ages.user.session.list</field>
        <field name="model">ages.user.session</field>
        <field name="arch" type="xml">
            <list string="Currently Online Users"
                  create="0"
                  edit="0"
                  delete="0"
                  js_class="ages_presence_list"
                  decoration-success="presence_state == 'active'"
                  decoration-info="presence_state == 'background'"
                  decoration-warning="presence_state == 'idle'"
                  decoration-muted="presence_state == 'inactive' or presence_state == 'logged_out'">
                <header>
                    <button name="action_force_logout"
                            type="object"
                            string="Force Logout"
                            class="btn-danger"
                            groups="ages_user_presence.group_presence_manager"
                            confirm="Invalidate the selected session(s) and log those browsers out?"/>
                </header>
                <field name="user_id"/>
                <field name="user_login" optional="show"/>
                <field name="authentication_display" string="Authentication"/>
                <field name="presence_display" string="Presence"/>
                <field name="presence_state" column_invisible="1"/>
                <field name="last_interaction"/>
                <field name="last_heartbeat"/>
                <field name="login_datetime"/>
                <field name="ip_address" optional="show"/>
                <field name="browser" optional="show"/>
                <field name="operating_system" optional="hide"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="session_duration" optional="show"/>
                <field name="device_type" optional="hide"/>
                <field name="logout_datetime" optional="hide"/>
                <field name="is_logged_in" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ages_user_session_form" model="ir.ui.view">
        <field name="name">ages.user.session.form</field>
        <field name="model">ages.user.session</field>
        <field name="arch" type="xml">
            <form string="User Session" create="0" edit="0" delete="0">
                <header>
                    <button name="action_force_logout"
                            type="object"
                            string="Force Logout"
                            class="btn-danger"
                            groups="ages_user_presence.group_presence_manager"
                            invisible="not is_logged_in"
                            confirm="Invalidate this session and log that browser out?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="user_id"/>
                        </h1>
                        <h3>
                            <field name="presence_display"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Authentication">
                            <field name="authentication_display"/>
                            <field name="user_login"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="login_datetime"/>
                            <field name="logout_datetime" invisible="is_logged_in"/>
                            <field name="logout_reason" invisible="is_logged_in"/>
                            <field name="session_duration"/>
                            <field name="is_logged_in" invisible="1"/>
                        </group>
                        <group string="Presence" name="presence">
                            <field name="presence_state" invisible="1"/>
                            <field name="last_interaction"/>
                            <field name="last_heartbeat"/>
                            <field name="visibility_state"/>
                            <field name="focus_state"/>
                        </group>
                    </group>
                    <group string="Session / device">
                        <group>
                            <field name="ip_address"/>
                            <field name="browser"/>
                            <field name="operating_system"/>
                            <field name="device_type"/>
                        </group>
                        <group>
                            <field name="session_identifier" groups="base.group_no_one"/>
                            <field name="user_agent" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ages_user_session_search" model="ir.ui.view">
        <field name="name">ages.user.session.search</field>
        <field name="model">ages.user.session</field>
        <field name="arch" type="xml">
            <search string="Online Users">
                <field name="user_id"/>
                <field name="user_login"/>
                <field name="company_id"/>
                <field name="ip_address"/>
                <field name="browser"/>
                <field name="presence_state"/>
                <separator/>
                <filter name="logged_in"
                        string="All Logged-In Users"
                        domain="[('is_logged_in', '=', True)]"/>
                <filter name="currently_active"
                        string="Currently Active"
                        domain="[('is_logged_in', '=', True), ('presence_state', '=', 'active')]"/>
                <filter name="background"
                        string="Background"
                        domain="[('is_logged_in', '=', True), ('presence_state', '=', 'background')]"/>
                <filter name="idle"
                        string="Idle"
                        domain="[('is_logged_in', '=', True), ('presence_state', '=', 'idle')]"/>
                <filter name="inactive"
                        string="Inactive"
                        domain="[('is_logged_in', '=', True), ('presence_state', '=', 'inactive')]"/>
                <filter name="logged_out"
                        string="Logged Out"
                        domain="[('presence_state', '=', 'logged_out')]"/>
                <separator/>
                <filter name="login_date" string="Login date" date="login_datetime"/>
                <filter name="last_activity_date" string="Last activity" date="last_interaction"/>
                <separator/>
                <group>
                    <filter name="group_presence" string="Presence State" context="{'group_by': 'presence_state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ages_user_session_online" model="ir.actions.act_window">
        <field name="name">Currently Online Users</field>
        <field name="res_model">ages.user.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_logged_in', '=', True)]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_ages_user_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No logged-in sessions right now
            </p>
            <p>
                Heartbeats from the Odoo web client appear here. Logged in is not the same as actively using Odoo.
            </p>
        </field>
    </record>

    <record id="action_ages_user_session_history" model="ir.actions.act_window">
        <field name="name">Session History</field>
        <field name="res_model">ages.user.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_logged_out': 1}</field>
        <field name="search_view_id" ref="view_ages_user_session_search"/>
    </record>

    <menuitem id="menu_ages_user_presence_online"
              name="Currently Online Users"
              parent="base.menu_users"
              action="action_ages_user_session_online"
              groups="ages_user_presence.group_presence_monitor"
              sequence="15"/>

    <menuitem id="menu_ages_user_presence_history"
              name="Session History"
              parent="base.menu_users"
              action="action_ages_user_session_history"
              groups="ages_user_presence.group_presence_monitor"
              sequence="16"/>
</odoo>
