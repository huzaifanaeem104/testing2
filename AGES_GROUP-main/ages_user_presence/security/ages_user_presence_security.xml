<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ages_user_presence" model="ir.module.category">
        <field name="name">User Presence</field>
        <field name="description">See who is logged into Odoo and whether they are actively using it.</field>
        <field name="sequence">92</field>
    </record>

    <record id="group_presence_monitor" model="res.groups">
        <field name="name">Monitor</field>
        <field name="category_id" ref="module_category_ages_user_presence"/>
        <field name="comment">Can view currently online users and presence history. Cannot force logout.</field>
    </record>

    <record id="group_presence_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_ages_user_presence"/>
        <field name="implied_ids" eval="[(4, ref('group_presence_monitor'))]"/>
        <field name="comment">Can force-logout sessions in addition to monitoring.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_presence_manager'))]"/>
    </record>
</odoo>
