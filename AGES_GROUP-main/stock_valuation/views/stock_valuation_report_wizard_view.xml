<odoo>
    <record id="view_stock_valuation_report_wizard" model="ir.ui.view">
        <field name="name">stock.valuation.wizard.form</field>
        <field name="model">stock.valuation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Simple Report">
                <group>
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="product_id"/>
<!--                    <field name="branch_id"/>-->
                </group>

                <footer>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
