<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_ages_mobilization_received" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ages.mobilization.received</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="ages_running_bills.view_move_form_ages_running_bill"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ages_running_bill_id']" position="after">
                <field name="ages_mobilization_advance_id" readonly="1"
                         invisible="move_type not in ('out_invoice', 'out_refund') or not ages_mobilization_advance_id"/>
            </xpath>
        </field>
    </record>

</odoo>
