<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ages_deletion_audit" model="ir.module.category">
        <field name="name">Deletion Audit</field>
        <field name="description">View and configure the centralized deletion audit trail.</field>
        <field name="sequence">94</field>
    </record>

    <record id="group_deletion_audit_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_ages_deletion_audit"/>
        <field name="comment">Can open Deleted Records in the modules they manage. Record rules limit them to those modules.</field>
    </record>

    <record id="group_deletion_audit_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_ages_deletion_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
        <field name="comment">Can view deletion logs across all business modules and configure include/exclude exceptions.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_manager'))]"/>
    </record>

    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="purchase.group_purchase_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="hr_attendance.group_hr_attendance_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>
    <record id="purchase_request.group_purchase_request_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_deletion_audit_viewer'))]"/>
    </record>

    <record id="rule_deletion_audit_manager" model="ir.rule">
        <field name="name">Deleted Records: administrator (all modules)</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('group_deletion_audit_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_deletion_audit_project" model="ir.rule">
        <field name="name">Deleted Records: project managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'project')]</field>
    </record>
    <record id="rule_deletion_audit_sales" model="ir.rule">
        <field name="name">Deleted Records: sales managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'sales')]</field>
    </record>
    <record id="rule_deletion_audit_purchase" model="ir.rule">
        <field name="name">Deleted Records: purchase managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'purchase')]</field>
    </record>
    <record id="rule_deletion_audit_accounting" model="ir.rule">
        <field name="name">Deleted Records: accounting managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="domain_force">[('business_module', 'in', ('accounting', 'expense'))]</field>
    </record>
    <record id="rule_deletion_audit_inventory" model="ir.rule">
        <field name="name">Deleted Records: inventory managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'inventory')]</field>
    </record>
    <record id="rule_deletion_audit_employees" model="ir.rule">
        <field name="name">Deleted Records: HR managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[('business_module', 'in', ('employees', 'payroll', 'attendances'))]</field>
    </record>
    <record id="rule_deletion_audit_attendance" model="ir.rule">
        <field name="name">Deleted Records: attendance managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'attendances')]</field>
    </record>
    <record id="rule_deletion_audit_purchase_request" model="ir.rule">
        <field name="name">Deleted Records: purchase request managers</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="groups" eval="[(4, ref('purchase_request.group_purchase_request_manager'))]"/>
        <field name="domain_force">[('business_module', '=', 'purchase_request')]</field>
    </record>

    <record id="rule_deletion_audit_company" model="ir.rule">
        <field name="name">Deleted Records: multi-company</field>
        <field name="model_id" ref="model_ages_deletion_audit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
