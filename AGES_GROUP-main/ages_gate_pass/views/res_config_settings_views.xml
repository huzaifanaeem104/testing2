<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ages_gate_pass" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ages.gate.pass</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="Gate Pass" name="ages_gate_pass_settings"
                       groups="ages_gate_pass.group_gate_pass_manager">
                    <setting string="Sequences"
                             help="Configure IGP / OGP / RGP numbering (also under Settings → Technical → Sequences).">
                        <div class="content-group">
                            <div class="mt8">
                                <button name="action_open_gate_pass_sequences" type="object"
                                        string="Configure Gate Pass Sequences"
                                        class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Security Groups"
                             help="Manage User / Edit / Edit Approval / Manager groups.">
                        <div class="content-group">
                            <div class="mt8">
                                <button name="action_open_gate_pass_groups" type="object"
                                        string="Edit Gate Pass Groups"
                                        class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
