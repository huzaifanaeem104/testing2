<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_ages_custom_access_je" model="ir.ui.view">
        <field name="name">res.users.form.inherit.ages.custom.access.je</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Custom Access Rights" name="ages_custom_access_rights">
                    <group string="Journal Entry" name="ages_je_access_rights">
                        <field name="je_access_draft"/>
                        <field name="je_access_validate"/>
                        <field name="je_access_post"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
