<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_ages_payroll_attendance" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.ages.payroll.attendance</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="ages_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_attendances"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        invisible="attendance_count == 0">
                    <field name="attendance_count" widget="statinfo" string="Attendances"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
