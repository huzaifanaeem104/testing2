<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ages_payroll_attendance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ages.payroll.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ages_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ages_hr_payroll']" position="inside">
                <block title="Attendance">
                    <setting string="Attendance Overtime"
                             help="Split approved attendance overtime on hourly payslips">
                        <field name="ages_payroll_attendance_overtime"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
