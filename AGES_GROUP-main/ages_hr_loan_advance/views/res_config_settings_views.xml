<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_loan_advance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.loan.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ages_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ages_hr_payroll']" position="inside">
                <block title="Advances">
                    <setting string="Advance Journal" help="Journal used for advance disbursement entries (sequence/short code)">
                        <field name="advance_journal_id"/>
                    </setting>
                    <setting string="Advance Receivable Account" help="Debited when an advance is confirmed">
                        <field name="advance_receivable_account_id"/>
                    </setting>
                    <setting string="Advance Payment Account" help="Default cash/bank account credited on advance disbursement">
                        <field name="advance_payment_account_id"/>
                    </setting>
                </block>
                <block title="Loans">
                    <setting string="Loan Journal" help="Journal used for loan disbursement entries (sequence/short code)">
                        <field name="loan_journal_id"/>
                    </setting>
                    <setting string="Loan Receivable Account" help="Debited when a loan is confirmed">
                        <field name="loan_receivable_account_id"/>
                    </setting>
                    <setting string="Loan Payment Account" help="Default cash/bank account credited on loan disbursement">
                        <field name="loan_payment_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
