<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_loan_advance" model="ir.ui.view">
        <field name="name">hr.payslip.form.loan.advance</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="ages_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='input_line_ids']/list" position="inside">
                <field name="advance_id" optional="hide"/>
                <field name="loan_installment_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
