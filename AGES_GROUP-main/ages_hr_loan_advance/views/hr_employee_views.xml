<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_loan_advance" model="ir.ui.view">
        <field name="name">hr.employee.form.loan.advance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_advances" type="object" class="oe_stat_button" icon="fa-ticket"
                        groups="ages_hr_payroll.group_hr_payroll_user">
                    <field name="advance_count" widget="statinfo" string="Advances"/>
                </button>
                <button name="action_open_loans" type="object" class="oe_stat_button" icon="fa-credit-card"
                        groups="ages_hr_payroll.group_hr_payroll_user">
                    <field name="loan_count" widget="statinfo" string="Loans"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
