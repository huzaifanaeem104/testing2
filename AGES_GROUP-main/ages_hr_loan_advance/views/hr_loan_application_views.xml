<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_installment_tree" model="ir.ui.view">
        <field name="name">hr.loan.installment.list</field>
        <field name="model">hr.loan.installment</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence"/>
                <field name="due_date"/>
                <field name="amount" sum="Total"/>
                <field name="amount_deducted"/>
                <field name="amount_residual"/>
                <field name="deduction_state" widget="badge"/>
                <field name="skip_next_payslip"/>
                <field name="payslip_id"/>
                <button name="action_mark_skipped" string="Skip" type="object"
                        invisible="skip_next_payslip or deduction_state == 'deducted'"/>
                <button name="action_resume_deduction" string="Resume" type="object"
                        invisible="not skip_next_payslip"/>
            </list>
        </field>
    </record>

    <record id="view_hr_loan_application_tree" model="ir.ui.view">
        <field name="name">hr.loan.application.list</field>
        <field name="model">hr.loan.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="amount" sum="Total"/>
                <field name="installment_count"/>
                <field name="installment_amount"/>
                <field name="amount_residual"/>
                <field name="deduction_state" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_hr_loan_application_form" model="ir.ui.view">
        <field name="name">hr.loan.application.form</field>
        <field name="model">hr.loan.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'to_approve'"
                            groups="ages_hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state != 'to_approve'"
                            groups="ages_hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="ages_hr_payroll.group_hr_payroll_manager"/>
                    <button name="action_compute_installments_preview" string="Compute Installments" type="object"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('to_approve', 'approved', 'cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('confirmed', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="installment_count" readonly="state == 'confirmed'"/>
                            <field name="first_installment_date" readonly="state == 'confirmed'"/>
                            <field name="installment_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="payment_method" readonly="state == 'confirmed'"/>
                            <field name="journal_id" readonly="state == 'confirmed'"/>
                            <field name="receivable_account_id" readonly="state == 'confirmed'"/>
                            <field name="payment_account_id" readonly="state == 'confirmed'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'confirmed'"/>
                            <field name="deduction_state" readonly="1"/>
                            <field name="amount_deducted" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="installment_count_done" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments" name="installments">
                            <field name="installment_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="due_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_deducted"/>
                                    <field name="amount_residual"/>
                                    <field name="deduction_state" widget="badge"/>
                                    <field name="skip_next_payslip"/>
                                    <field name="payslip_id"/>
                                    <button name="action_mark_skipped" string="Skip" type="object"
                                            invisible="skip_next_payslip or deduction_state == 'deducted'"/>
                                    <button name="action_resume_deduction" string="Resume" type="object"
                                            invisible="not skip_next_payslip"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_loan_application_search" model="ir.ui.view">
        <field name="name">hr.loan.application.search</field>
        <field name="model">hr.loan.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Pending Deduction" name="pending_deduction"
                        domain="[('deduction_state', 'in', ('pending', 'partial'))]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_loan_application" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">hr.loan.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_loan_application_search"/>
    </record>
</odoo>
