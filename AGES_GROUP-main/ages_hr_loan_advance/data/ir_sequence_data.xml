<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hr_advance_application" model="ir.sequence">
            <field name="name">Advance Application</field>
            <field name="code">hr.advance.application</field>
            <field name="prefix">ADV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_hr_loan_application" model="ir.sequence">
            <field name="name">Loan Application</field>
            <field name="code">hr.loan.application</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
