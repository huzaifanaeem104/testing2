<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_ages_expense" model="ir.ui.view">
        <field name="name">account.payment.form.ages.expense</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_ages_expense"
                        type="object"
                        string="Expense"
                        class="btn btn-secondary"
                        display="always"
                        invisible="not ages_expense_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="ages_expense_id" invisible="1"/>
                <button name="action_open_ages_expense"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bars"
                        invisible="not ages_expense_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Expense</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
