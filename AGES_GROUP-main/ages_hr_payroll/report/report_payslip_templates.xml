<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Payslip <span t-field="o.number"/></h2>
                        <div class="row mt16 mb16">
                            <div class="col-6">
                                <strong>Employee:</strong> <span t-field="o.employee_id"/><br/>
                                <strong>Contract:</strong> <span t-field="o.contract_id"/><br/>
                                <strong>Structure:</strong> <span t-field="o.struct_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong>
                                <span t-field="o.date_from"/> - <span t-field="o.date_to"/><br/>
                                <strong>Company:</strong> <span t-field="o.company_id"/>
                            </div>
                        </div>
                        <h4>Worked Days</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Days</th>
                                    <th class="text-end">Hours</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.worked_days_line_ids" t-as="wd">
                                    <td><span t-field="wd.name"/></td>
                                    <td class="text-end"><span t-field="wd.number_of_days"/></td>
                                    <td class="text-end"><span t-field="wd.number_of_hours"/></td>
                                    <td class="text-end"><span t-field="wd.amount"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h4>Salary Computation</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip)" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.code"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.rate"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                    <td class="text-end"><span t-field="line.total"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr><td>Basic</td><td class="text-end"><span t-field="o.basic_wage"/></td></tr>
                                    <tr><td>Gross</td><td class="text-end"><span t-field="o.gross_wage"/></td></tr>
                                    <tr class="fw-bold"><td>Net</td><td class="text-end"><span t-field="o.net_wage"/></td></tr>
                                </table>
                            </div>
                        </div>
                        <t t-set="payroll_notes" t-value="o.env['hr.payroll.note'].search([('company_id', 'in', [False, o.company_id.id])])"/>
                        <t t-if="payroll_notes">
                            <div class="mt32">
                                <t t-foreach="payroll_notes" t-as="pn">
                                    <div t-field="pn.note"/>
                                </t>
                            </div>
                        </t>
                        <t t-if="o.note">
                            <div class="mt16"><strong>Note:</strong> <span t-field="o.note"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_payslip_light">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Payslip <span t-field="o.number"/></h2>
                        <p>
                            <strong>Employee:</strong> <span t-field="o.employee_id"/><br/>
                            <strong>Period:</strong>
                            <span t-field="o.date_from"/> - <span t-field="o.date_to"/>
                        </p>
                        <table class="table table-sm">
                            <tr><td>Gross</td><td class="text-end"><span t-field="o.gross_wage"/></td></tr>
                            <tr class="fw-bold"><td>Net</td><td class="text-end"><span t-field="o.net_wage"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
