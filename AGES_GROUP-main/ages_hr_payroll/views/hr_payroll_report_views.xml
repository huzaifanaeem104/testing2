<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_report_view_pivot" model="ir.ui.view">
        <field name="name">hr.payroll.report.pivot</field>
        <field name="model">hr.payroll.report</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Analysis">
                <field name="employee_id" type="row"/>
                <field name="net_wage" type="measure"/>
                <field name="gross_wage" type="measure"/>
                <field name="basic_wage" type="measure"/>
                <field name="count" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="hr_payroll_report_view_graph" model="ir.ui.view">
        <field name="name">hr.payroll.report.graph</field>
        <field name="model">hr.payroll.report</field>
        <field name="arch" type="xml">
            <graph string="Payroll Analysis">
                <field name="employee_id"/>
                <field name="net_wage" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_hr_payroll_report" model="ir.actions.act_window">
        <field name="name">Payroll Analysis</field>
        <field name="res_model">hr.payroll.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>
