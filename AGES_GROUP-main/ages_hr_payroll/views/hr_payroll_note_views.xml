<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_note_view_tree" model="ir.ui.view">
        <field name="name">hr.payroll.note.list</field>
        <field name="model">hr.payroll.note</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_payroll_note_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.note.form</field>
        <field name="model">hr.payroll.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_note" model="ir.actions.act_window">
        <field name="name">Payroll Notes</field>
        <field name="res_model">hr.payroll.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
