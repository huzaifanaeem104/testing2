<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_payslips" type="object" class="oe_stat_button" icon="fa-money"
                        groups="ages_hr_payroll.group_hr_payroll_user">
                    <field name="payslip_count" widget="statinfo" string="Payslips"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
