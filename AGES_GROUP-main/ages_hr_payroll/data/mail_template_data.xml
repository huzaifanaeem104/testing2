<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_new_payslip" model="mail.template">
        <field name="name">Payroll: New Payslip</field>
        <field name="model_id" ref="model_hr_payslip"/>
        <field name="subject">Your payslip {{ object.number or object.name }}</field>
        <field name="email_to">{{ object.employee_id.work_email }}</field>
        <field name="body_html" type="html">
            <p>Hello <t t-out="object.employee_id.name"/>,</p>
            <p>Your payslip for period
               <t t-out="object.date_from"/> - <t t-out="object.date_to"/>
               is available.</p>
        </field>
    </record>
</odoo>
