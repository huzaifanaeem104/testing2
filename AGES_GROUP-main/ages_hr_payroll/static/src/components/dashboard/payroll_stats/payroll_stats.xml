<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="ages_hr_payroll.DashboardStats">
        <div class="o_hr_payroll_dashboard_block o_hr_payroll_dashboard_block_stats card d-flex align-items-stretch flex-column h-100">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center w-100 border-0 bg-view">
                <h2 class="card-title" t-esc="props.title"/>
                <div class="d-flex" id="period_selection_toggle">
                    Annually
                    <div class="o_boolean_toggle cursor-pointer form-check form-switch o_switch_toggle ms-2"
                         t-on-click.stop.prevent="toggle">
                        <input type="checkbox" class="form-check-input" role="switch" t-att-checked="state.monthly"/>
                    </div>
                    Monthly
                </div>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <t t-foreach="props.actions" t-as="action" t-key="action_index">
                    <a t-if="action.count &gt; 0" class="d-flex w-100" href="#"
                       t-on-click.prevent="() => this.actionService.doAction(action.action)">
                        <span class="me-1" t-esc="action.count"/>
                        <t t-esc="action.string"/>
                    </a>
                </t>
                <div class="canvas-container mt-auto d-flex align-items-end payroll_bar" style="min-height: 160px;">
                    <canvas t-ref="canvas" class="w-100"/>
                </div>
            </div>
        </div>
    </t>
</templates>
