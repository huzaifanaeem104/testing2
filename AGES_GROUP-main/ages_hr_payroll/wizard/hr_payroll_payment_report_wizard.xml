<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_payment_report_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.payment.report.wizard.form</field>
        <field name="model">hr.payroll.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="export_format"/>
                    <field name="payslip_run_id" invisible="1"/>
                    <field name="payslip_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="generate_payment_report" type="object" string="Export" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
