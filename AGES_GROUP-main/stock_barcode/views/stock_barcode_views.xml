<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_barcode_action_main" model="ir.actions.client">
        <field name="name">Barcode</field>
        <field name="tag">stock_barcode_client</field>
    </record>
    <record id="stock_barcode_action_inventory" model="ir.actions.client">
        <field name="name">Barcode Inventory</field>
        <field name="tag">stock_barcode_client</field>
        <field name="context">{'inventory': True}</field>
    </record>
    <record id="product_action_barcodes" model="ir.actions.act_window">
        <field name="name">Product Barcodes</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
    </record>
    <record id="product_product_barcode_list" model="ir.ui.view">
        <field name="name">product.product.barcode.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="default_code"/>
                <field name="name"/>
                <field name="barcode"/>
                <field name="qty_available"/>
            </list>
        </field>
    </record>
    <record id="product_action_barcodes_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_product_barcode_list"/>
        <field name="act_window_id" ref="product_action_barcodes"/>
    </record>

    <menuitem id="stock_barcode_menu" name="Barcode" parent="stock.menu_stock_root" sequence="15"
              action="stock_barcode_action_main" groups="stock.group_stock_user"/>
</odoo>
