<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ages_material_consumption_return_form" model="ir.ui.view">
        <field name="name">ages.material.consumption.return.form</field>
        <field name="model">ages.material.consumption.return</field>
        <field name="arch" type="xml">
            <form string="Return">
                <field name="consumption_id" readonly="1"/>
                <field name="company_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="consumption_line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="quantity_done" string="Consumed" readonly="1"/>
                        <field name="qty_returned" string="Already Returned" readonly="1"/>
                        <field name="quantity" string="Quantity"/>
                        <!-- Keep uom in the payload for all users (not only uom.group_uom) -->
                        <field name="uom_id" optional="hide" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_return" type="object" string="Return"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ages_material_consumption_return" model="ir.actions.act_window">
        <field name="name">Return</field>
        <field name="res_model">ages.material.consumption.return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_ages_material_consumption_return_form"/>
    </record>

</odoo>
