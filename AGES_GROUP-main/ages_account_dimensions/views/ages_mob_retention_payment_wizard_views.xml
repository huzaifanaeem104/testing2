<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ages_mob_retention_payment_wizard_form" model="ir.ui.view">
        <field name="name">ages.mob.retention.payment.wizard.form</field>
        <field name="model">ages.mob.retention.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Payment">
                <group>
                    <group string="Payment">
                        <field name="payment_date"/>
                        <field name="journal_id"/>
                        <field name="payment_method_line_id"
                                 options="{'no_create': True, 'no_open': True}"/>
                        <field name="amount"/>
                        <field name="amount_remaining" readonly="1"/>
                        <field name="communication"/>
                        <field name="should_withhold_tax" invisible="not display_withholding"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="payment_type" invisible="1"/>
                        <field name="display_withholding" invisible="1"/>
                        <field name="withholding_hide_tax_base_account" invisible="1"/>
                        <field name="withholding_payment_account_id" invisible="1"/>
                        <field name="available_payment_method_line_ids" invisible="1"/>
                    </group>
                    <group string="Dimensions">
                        <field name="partner_id"/>
                        <field name="ages_sub_company_id"/>
                        <field name="ages_contract_id"/>
                        <field name="ages_project_id"/>
                        <field name="ages_analytic_account_id"/>
                        <field name="ages_mobilization_advance_id"
                                 invisible="not ages_mobilization_advance_id"/>
                        <field name="ages_retention_recovery_id"
                                 invisible="not ages_retention_recovery_id"/>
                    </group>
                </group>
                <notebook invisible="not should_withhold_tax or not display_withholding">
                    <page string="Withholding" name="withholding_page">
                        <field name="withholding_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="source_base_amount_currency" column_invisible="True"/>
                                <field name="source_base_amount" column_invisible="True"/>
                                <field name="source_tax_amount_currency" column_invisible="True"/>
                                <field name="source_tax_amount" column_invisible="True"/>
                                <field name="source_currency_id" column_invisible="True"/>
                                <field name="comodel_currency_id" column_invisible="True"/>
                                <field name="placeholder_value" column_invisible="True"/>
                                <field name="name"
                                       required="not withholding_sequence_id"
                                       widget="char_with_placeholder_field"
                                       options="{'placeholder_field': 'placeholder_value'}"
                                       width="92px"/>
                                <field name="account_id"
                                       column_invisible="parent.withholding_hide_tax_base_account"
                                       width="184px"
                                       optional="show"/>
                                <field name="base_amount"/>
                                <field name="tax_id"
                                       options="{'no_open': True, 'no_create': True}"
                                       width="92px"/>
                                <field name="analytic_distribution"
                                       widget="analytic_distribution"
                                       groups="analytic.group_analytic_accounting"
                                       optional="hide"
                                       width="200px"/>
                                <field name="amount" sum="Total Withheld Amount"/>
                                <field name="withholding_sequence_id" column_invisible="True"/>
                                <field name="company_id" column_invisible="True"/>
                                <field name="type_tax_use" column_invisible="True"/>
                            </list>
                        </field>
                        <group>
                            <group/>
                            <group>
                                <field name="withholding_net_amount"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_payment" type="object"
                            string="Create Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
