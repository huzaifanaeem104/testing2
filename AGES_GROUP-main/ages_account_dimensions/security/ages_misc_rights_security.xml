<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hide_other_users_bills" model="res.groups">
        <field name="name">Hide other users' bills</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Only vendor bills created by this user are visible.</field>
    </record>
    <record id="group_hide_other_users_jes" model="res.groups">
        <field name="name">Hide other users' journal entries</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Only journal entries created by this user are visible.</field>
    </record>

    <record id="rule_hide_other_users_bills_move" model="ir.rule">
        <field name="name">AGES: own vendor bills only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('group_hide_other_users_bills'))]"/>
        <field name="domain_force">
            ['|',
             ('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')),
             ('create_uid', '=', user.id)]
        </field>
    </record>
    <record id="rule_hide_other_users_bills_line" model="ir.rule">
        <field name="name">AGES: own vendor bill lines only</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(4, ref('group_hide_other_users_bills'))]"/>
        <field name="domain_force">
            ['|',
             ('move_id.move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')),
             ('move_id.create_uid', '=', user.id)]
        </field>
    </record>

    <record id="rule_hide_other_users_jes_move" model="ir.rule">
        <field name="name">AGES: own journal entries only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('group_hide_other_users_jes'))]"/>
        <field name="domain_force">
            ['|',
             ('move_type', '!=', 'entry'),
             ('create_uid', '=', user.id)]
        </field>
    </record>
    <record id="rule_hide_other_users_jes_line" model="ir.rule">
        <field name="name">AGES: own journal entry lines only</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(4, ref('group_hide_other_users_jes'))]"/>
        <field name="domain_force">
            ['|',
             ('move_id.move_type', '!=', 'entry'),
             ('move_id.create_uid', '=', user.id)]
        </field>
    </record>
</odoo>
