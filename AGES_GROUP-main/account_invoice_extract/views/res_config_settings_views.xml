<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_invoice_extract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.invoice.extract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="account_ocr_settings" position="inside">
                <div class="content-group mt16" invisible="not module_account_extract">
                    <div class="row mt8">
                        <label for="extract_in_invoice_digitalization_mode" class="col-lg-3 o_light_label"/>
                        <field name="extract_in_invoice_digitalization_mode" widget="radio" required="module_account_extract"/>
                    </div>
                    <div class="row mt8">
                        <label for="extract_out_invoice_digitalization_mode" class="col-lg-3 o_light_label"/>
                        <field name="extract_out_invoice_digitalization_mode" widget="radio" required="module_account_extract"/>
                    </div>
                </div>
            </setting>
            <setting id="account_ocr_settings" position="after">
                <setting id="extract_single_line_per_tax"
                         company_dependent="1"
                         help="Enable to get only one invoice line per tax"
                         invisible="not module_account_extract">
                    <field name="extract_single_line_per_tax"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
