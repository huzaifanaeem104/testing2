<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_opal_vendor_map_list" model="ir.ui.view">
        <field name="name">opal.vendor.map.list</field>
        <field name="model">opal.vendor.map</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="partner_id, vendor_name">
                <field name="vendor_name"/>
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_opal_vendor_map_form" model="ir.ui.view">
        <field name="name">opal.vendor.map.form</field>
        <field name="model">opal.vendor.map</field>
        <field name="arch" type="xml">
            <form string="OPAL Vendor Map">
                <sheet>
                    <group>
                        <field name="vendor_name"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_opal_vendor_map_search" model="ir.ui.view">
        <field name="name">opal.vendor.map.search</field>
        <field name="model">opal.vendor.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="vendor_name"/>
                <field name="partner_id"/>
                <filter name="unmapped" string="Unmapped" domain="[('partner_id', '=', False)]"/>
                <filter name="mapped" string="Mapped" domain="[('partner_id', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_opal_vendor_map" model="ir.actions.act_window">
        <field name="name">OPAL Vendor Mapping</field>
        <field name="res_model">opal.vendor.map</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_opal_vendor_map_search"/>
        <field name="context">{'search_default_unmapped': 1}</field>
    </record>

    <record id="view_opal_project_map_list" model="ir.ui.view">
        <field name="name">opal.project.map.list</field>
        <field name="model">opal.project.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="project_code"/>
                <field name="project_name"/>
                <field name="project_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="action_opal_project_map" model="ir.actions.act_window">
        <field name="name">OPAL Project Mapping</field>
        <field name="res_model">opal.project.map</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
