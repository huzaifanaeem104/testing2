        <field name="name">account.move.list.ages.reports.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_print_journal_entry" type="object" string="Print JEs"/>
                    <button name="action_print_journal_items" type="object" string="Print Journal Items"/>
                </header>
            </xpath>
        </field>
    </record>

