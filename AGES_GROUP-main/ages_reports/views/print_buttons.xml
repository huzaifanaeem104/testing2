<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ages_reports_print" model="ir.ui.view">
        <field name="name">account.move.form.ages.reports.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_print_bill" type="object" string="Print Bill"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
                <button name="action_print_journal_entry" type="object" string="Print JEs"/>
                <button name="action_print_journal_items" type="object" string="Print Journal Items"/>
            </xpath>
        </field>
    </record>

