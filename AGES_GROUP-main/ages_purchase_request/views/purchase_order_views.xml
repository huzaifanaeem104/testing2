<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_ages" model="ir.ui.view">
        <field name="name">purchase.order.form.ages.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="ages_project_id"
                       readonly="state in ['cancel', 'done', 'purchase']"
                       options="{'no_create': True}"/>
                <field name="ages_analytic_account_id"
                       readonly="state in ['cancel', 'done', 'purchase']"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_ages" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.ages.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ages_project_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_view_tree_ages" model="ir.ui.view">
        <field name="name">purchase.order.view.list.ages.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ages_project_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
